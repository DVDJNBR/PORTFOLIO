---
interface Props {
  title?: string;
  preloadImages?: string[];
}
const { title = 'dvdjnbr — Portfolio', preloadImages = [] } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {preloadImages.map((url) => <link rel="preload" as="image" href={url} />)}
    <style is:global>
      :root {
        /* Warm near-black base (not navy). Default text is neutral gray —
           the CV's beige/khaki is a deliberate small accent (kicker, tags,
           per-project glows), not the everyday reading color, plus a soft
           blue accent for interactive touches (hover, active states) so the
           palette has two small points of color instead of one that's
           everywhere. */
        --bg: #14120f;
        --surface: #19191a;
        --elevated: #212122;
        --fg: #d6d3ce;
        --fg-muted: #8f8c86;
        --accent: #c9a876;
        --accent-blue: #6fa3d8;
        --accent-gold: #d4b483;
        --accent-klein: #002fa7;
        --accent-orange: #e8823f;
        --border: rgba(214, 211, 206, 0.1);
        --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.35);
        --shadow-md: 0 6px 16px rgba(0, 0, 0, 0.45);
        --shadow-lg: 0 16px 40px rgba(0, 0, 0, 0.6);
        --font-display: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'Helvetica Neue', Helvetica, Arial, sans-serif;
        --ease-apple: cubic-bezier(0.25, 0.1, 0.25, 1);
      }

      *, *::before, *::after {
        box-sizing: border-box;
      }

      html, body {
        margin: 0;
        padding: 0;
        color: var(--fg);
        font-family: var(--font-display);
        min-height: 100vh;
      }

      html {
        background: var(--bg);
      }

      body {
        background: transparent;
        transition: background-color 0.4s ease, color 0.3s ease;
      }

      .ambient-bg {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background: var(--bg);
      }
    </style>
  </head>
  <body>
    <div class="ambient-bg" aria-hidden="true"></div>
    <slot />
  </body>
</html>
