---
interface Props {
  title?: string;
  preloadImages?: string[];
}
const { title = 'dvdjnbr — Portfolio', preloadImages = [] } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {preloadImages.map((url) => <link rel="preload" as="image" href={url} />)}
    <style is:global>
      :root {
        --bg: #0a1628;
        --surface: #0d1119;
        --elevated: #131826;
        --fg: #f2f4f8;
        --fg-muted: #8b95a5;
        --accent: #57c7ff;
        --accent-gold: #f4c542;
        --border: rgba(255, 255, 255, 0.1);
        --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.35);
        --shadow-md: 0 6px 16px rgba(0, 0, 0, 0.45);
        --shadow-lg: 0 16px 40px rgba(0, 0, 0, 0.6);
        --font-display: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'Helvetica Neue', Helvetica, Arial, sans-serif;
        --ease-apple: cubic-bezier(0.25, 0.1, 0.25, 1);
      }

      *, *::before, *::after {
        box-sizing: border-box;
      }

      html, body {
        margin: 0;
        padding: 0;
        color: var(--fg);
        font-family: var(--font-display);
        min-height: 100vh;
      }

      html {
        background: var(--bg);
      }

      body {
        background: transparent;
        transition: background-color 0.4s ease, color 0.3s ease;
      }

      .ambient-bg {
        position: fixed;
        inset: 0;
        z-index: -1;
        overflow: hidden;
        pointer-events: none;
        background: var(--bg);
      }

      .gradient-sphere {
        position: absolute;
        top: 50%;
        left: 50%;
        border-radius: 50%;
        filter: blur(60px);
      }

      .sphere-1 {
        width: 34vw;
        height: 34vw;
        margin: -17vw 0 0 -17vw;
        background: linear-gradient(
          40deg,
          color-mix(in srgb, var(--accent) 48%, transparent),
          color-mix(in srgb, var(--accent) 4%, transparent)
        );
        animation: orbit-1 26s linear infinite;
      }

      .sphere-2 {
        width: 36vw;
        height: 36vw;
        margin: -18vw 0 0 -18vw;
        background: linear-gradient(
          240deg,
          color-mix(in srgb, var(--accent) 40%, #001a3d),
          color-mix(in srgb, var(--accent) 4%, transparent)
        );
        animation: orbit-2 34s linear infinite reverse;
      }

      .sphere-3 {
        width: 26vw;
        height: 26vw;
        margin: -13vw 0 0 -13vw;
        background: linear-gradient(
          120deg,
          color-mix(in srgb, var(--accent) 35%, white),
          color-mix(in srgb, var(--accent) 3%, transparent)
        );
        animation: orbit-3 20s linear infinite;
      }

      .shadow-orb {
        position: absolute;
        top: 50%;
        left: 50%;
        border-radius: 50%;
        filter: blur(60px);
        background: radial-gradient(
          circle,
          color-mix(in srgb, var(--bg) 55%, black) 0%,
          transparent 75%
        );
      }

      .shadow-orb-1 {
        width: 17vw;
        height: 17vw;
        margin: -8.5vw 0 0 -8.5vw;
        animation: orbit-4 30s linear infinite;
      }

      .shadow-orb-2 {
        width: 13vw;
        height: 13vw;
        margin: -6.5vw 0 0 -6.5vw;
        animation: orbit-5 22s linear infinite reverse;
      }

      @keyframes orbit-4 {
        from {
          transform: rotate(0deg) translateX(11vw) rotate(0deg);
        }
        to {
          transform: rotate(360deg) translateX(11vw) rotate(-360deg);
        }
      }

      @keyframes orbit-5 {
        from {
          transform: rotate(0deg) translateX(6vw) rotate(0deg);
        }
        to {
          transform: rotate(360deg) translateX(6vw) rotate(-360deg);
        }
      }

      @keyframes orbit-1 {
        from {
          transform: rotate(0deg) translateX(13vw) rotate(0deg);
        }
        to {
          transform: rotate(360deg) translateX(13vw) rotate(-360deg);
        }
      }

      @keyframes orbit-2 {
        from {
          transform: rotate(0deg) translateX(9vw) rotate(0deg);
        }
        to {
          transform: rotate(360deg) translateX(9vw) rotate(-360deg);
        }
      }

      @keyframes orbit-3 {
        from {
          transform: rotate(0deg) translateX(7vw) rotate(0deg);
        }
        to {
          transform: rotate(360deg) translateX(7vw) rotate(-360deg);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .sphere-1,
        .sphere-2,
        .sphere-3,
        .shadow-orb-1,
        .shadow-orb-2 {
          animation: none;
        }
      }
    </style>
  </head>
  <body>
    <div class="ambient-bg" aria-hidden="true">
      <span class="shadow-orb shadow-orb-1"></span>
      <span class="shadow-orb shadow-orb-2"></span>
      <span class="gradient-sphere sphere-1"></span>
      <span class="gradient-sphere sphere-2"></span>
      <span class="gradient-sphere sphere-3"></span>
    </div>
    <slot />
  </body>
</html>
