---
interface Props {
  title: string;
  description: string;
  url: string;
  tags: string[];
  backdrop?: string | null;
  depth?: string | null;
  accent?: string;
}

const { title, description, url, tags, backdrop = null, depth = null, accent } = Astro.props;
---

<div class="project-block" style={accent ? `--cell-glow: ${accent};` : undefined}>
  <div class="visual">
    {depth && <img src={depth} alt="" class="silhouette-depth" />}
    {backdrop && <img src={backdrop} alt="" class="silhouette" />}
  </div>

  <a href={url} target="_blank" rel="noopener noreferrer" class="info">
    <span class="fighter-name">{title}</span>
    <span class="name-rule"></span>
    <p class="info-desc">{description}</p>
    <div class="info-tags">
      {tags.map((tag) => <span class="tag">#{tag}</span>)}
    </div>
    <span class="info-arrow">→</span>
    <svg class="info-glow" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <rect x="0" y="0" width="100" height="100" pathLength="100" class="info-glow-blur"></rect>
    </svg>
  </a>
</div>

<style>
  .project-block {
    position: relative;
    width: 100%;
    max-width: 1040px;
    aspect-ratio: 2 / 1;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .visual {
    position: absolute;
    inset: 0;
    width: 66.6667%;
    z-index: 0;
  }

  .silhouette {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: perspective(1400px) rotateY(-7deg);
    transform-origin: right center;
    z-index: 1;
  }

  .silhouette-depth {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: perspective(1400px) rotateY(-7deg) translateX(-10px);
    transform-origin: right center;
    z-index: 0;
    opacity: 0.4;
    filter: blur(2px);
  }

  .info {
    position: absolute;
    top: 20px;
    right: 20px;
    height: 66.6667%;
    left: calc(66.6667% - 40px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    text-align: left;
    gap: 0.65rem;
    text-decoration: none;
    color: inherit;
    padding: 1.75rem 2rem;
    box-sizing: border-box;
    z-index: 1;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.3);
    border: none;
    border-radius: 0;
    transition: background 0.25s var(--ease-apple);
    clip-path: inset(0 100% 0 0);
    animation: panel-reveal 0.35s var(--ease-apple) forwards;
  }
  .info:hover {
    background: rgba(0, 0, 0, 0.4);
  }
  .info::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    z-index: 2;
    background: linear-gradient(to bottom, transparent, var(--accent-gold), transparent);
    box-shadow: 0 0 10px color-mix(in srgb, var(--accent-gold) 80%, transparent);
    animation: panel-beam 0.35s var(--ease-apple) forwards;
  }

  @keyframes panel-reveal {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes panel-beam {
    from {
      left: 0%;
      opacity: 1;
    }
    to {
      left: 100%;
      opacity: 0;
    }
  }

  .info-glow {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    pointer-events: none;
  }

  .info-glow-blur {
    fill: none;
    stroke-linecap: round;
    stroke-dasharray: 8 92;
    animation: info-glow-travel 26s linear infinite;
    stroke: color-mix(in srgb, var(--cell-glow, var(--accent-gold)) 55%, white);
    stroke-width: 3;
    filter: blur(7px);
    opacity: 0.85;
  }

  @keyframes info-glow-travel {
    to {
      stroke-dashoffset: -100;
    }
  }

  .fighter-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.4rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--fg);
  }

  .name-rule {
    width: 12px;
    height: 12px;
    border-radius: 2px;
    background: var(--accent-gold);
    transform: rotate(45deg);
  }

  .info-desc {
    margin: 0;
    font-size: 0.85rem;
    color: var(--fg-muted);
    line-height: 1.55;
  }

  .info-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 0.3rem 0.55rem;
    width: 100%;
  }

  .tag {
    font-size: 0.56rem;
    font-weight: 700;
    color: color-mix(in srgb, var(--fg-muted) 65%, var(--bg) 35%);
    letter-spacing: -0.01em;
  }

  .info-arrow {
    align-self: center;
    color: var(--accent);
    font-size: 1.2rem;
    transition: transform 0.25s var(--ease-apple), color 0.2s;
  }
  .info:hover .info-arrow {
    transform: translateX(4px);
    color: var(--fg);
  }

  @media (max-width: 700px) {
    .project-block {
      aspect-ratio: auto;
      height: 100%;
    }

    .visual {
      position: absolute;
      inset: 0;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .silhouette-depth {
      display: none;
    }

    .silhouette {
      position: static;
      width: auto;
      max-width: 220px;
      height: auto;
      object-fit: contain;
      transform: none;
    }

    .info {
      position: absolute;
      top: 50%;
      right: 0;
      left: auto;
      bottom: auto;
      height: auto;
      width: auto;
      max-width: calc(100% - 1.5rem);
      transform: translateY(-50%);
      padding: 1.25rem 1.5rem;
    }
  }
</style>
