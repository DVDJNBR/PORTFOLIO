---
import { tagBadge } from '../data/tags';

interface Props {
  title: string;
  description: string;
  url: string;
  tags: string[];
  backdrop?: string | null;
  depth?: string | null;
  accent?: string;
  denseVisual?: boolean;
}

const { title, description, url, tags, backdrop = null, depth = null, accent, denseVisual = false } = Astro.props;
---

<div
  class={`project-block${denseVisual ? ' is-dense' : ''}`}
  style={accent ? `--cell-glow: ${accent};` : undefined}
>
  <div class="visual">
    <slot name="visual">
      {depth && <img src={depth} alt="" class="silhouette-depth" />}
      {backdrop && <img src={backdrop} alt="" class="silhouette" />}
    </slot>
  </div>

  <a href={url} target="_blank" rel="noopener noreferrer" class="info">
    <span class="project-title">{title}</span>
    <p class="info-desc">{description}</p>
    <div class="info-tags">
      {tags.map((tag) => (
        <span class="project-tag" data-tag={tag} role="button" tabindex="0" title={`Filtrer par ${tag}`}>
          <img src={tagBadge(tag)} alt={tag} class="project-tag-img" loading="lazy" />
        </span>
      ))}
    </div>
    <span class="project-link-cta">Explorer le projet <span class="cta-arrow">→</span></span>
    <svg class="info-glow" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <rect x="0" y="0" width="100" height="100" pathLength="100" class="info-glow-blur"></rect>
    </svg>
  </a>
</div>

<style>
  .project-block {
    position: relative;
    width: 100%;
    height: 100%;
    margin: 0;
    box-sizing: border-box;
    display: flex;
    overflow: hidden;
  }

  .visual {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 60%;
    z-index: 1;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #12100e;
  }

  :global(.silhouette) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    z-index: 1;
    background: transparent;
  }

  :global(.silhouette-depth) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    z-index: 0;
    opacity: 0.35;
    filter: blur(2px);
  }

  .info {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: 40%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    text-align: left;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
    padding: 1.75rem 2rem;
    box-sizing: border-box;
    z-index: 2;
    background: rgba(18, 16, 14, 0.78);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-left: 1px solid rgba(255, 255, 255, 0.07);
    transition: background 0.25s var(--ease-apple), border-color 0.25s var(--ease-apple);
  }

  .info:hover {
    background: rgba(24, 21, 18, 0.88);
    border-left-color: rgba(255, 255, 255, 0.14);
  }

  .info-glow {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    pointer-events: none;
  }

  .info-glow-blur {
    fill: none;
    stroke-linecap: round;
    stroke-dasharray: 25 75;
    stroke: color-mix(in srgb, var(--cell-glow, var(--accent-gold)) 55%, white);
    stroke-width: 3;
    filter: blur(7px);
    opacity: 0.85;
  }

  .project-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.55rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0;
  }

  .info-desc {
    margin: 0;
    font-size: 0.88rem;
    color: #a1a1aa;
    line-height: 1.6;
  }

  .info-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 0.35rem 0.45rem;
    width: 100%;
    margin-top: 0.15rem;
    z-index: 2;
  }

  .project-tag {
    display: inline-flex;
    cursor: pointer;
    border-radius: 4px;
    transition: transform 0.2s var(--ease-apple), filter 0.2s var(--ease-apple);
  }

  .project-tag:hover {
    transform: translateY(-2px) scale(1.05);
    filter: drop-shadow(0 4px 8px color-mix(in srgb, var(--cell-glow, var(--accent-blue)) 75%, transparent));
  }

  .project-tag-img {
    height: 20px;
    width: auto;
    border-radius: 3px;
    display: block;
    pointer-events: none;
  }

  .project-link-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.35rem;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--cell-glow, var(--accent-blue));
    transition: color 0.2s var(--ease-apple), filter 0.2s var(--ease-apple);
  }

  .cta-arrow {
    display: inline-block;
    transition: transform 0.25s var(--ease-apple);
  }

  .info:hover .cta-arrow {
    transform: translateX(4px);
  }

  .info:hover .project-link-cta {
    filter: drop-shadow(0 0 10px color-mix(in srgb, var(--cell-glow, var(--accent-blue)) 65%, transparent));
  }

  @media (max-width: 700px) {
    .project-block {
      aspect-ratio: auto;
      height: auto;
      display: flex;
      flex-direction: column;
    }

    .visual {
      position: relative;
      width: 100%;
      height: 220px;
    }

    :global(.silhouette-depth) {
      display: none;
    }

    :global(.silhouette) {
      position: static;
      width: auto;
      max-width: 100%;
      max-height: 100%;
      height: auto;
      object-fit: contain;
      transform: none;
    }

    .info {
      position: relative;
      width: 100%;
      height: auto;
      border-left: none;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      padding: 1.25rem 1.25rem;
    }
  }
</style>
