---
interface Props {
  title: string;
  description: string;
  url: string;
  backdrop?: string | null;
}

const { title, description, url, backdrop = null } = Astro.props;
---

<div class="project-block">
  <div class="visual">
    {backdrop && <img src={backdrop} alt="" class="silhouette" />}
  </div>

  <a href={url} target="_blank" rel="noopener noreferrer" class="info">
    <span class="fighter-name">{title}</span>
    <p class="info-desc">{description}</p>
    <span class="info-arrow">→</span>
  </a>
</div>

<style>
  .project-block {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    height: 100%;
    position: relative;
  }

  .visual {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    position: relative;
    z-index: 0;
  }

  .silhouette {
    width: 460px;
    max-width: 90vw;
    height: auto;
  }

  .info {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
    padding: 0 1rem;
    max-width: 260px;
    margin: 0 auto;
  }

  .fighter-name {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    transition: color 0.2s;
  }
  .info:hover .fighter-name {
    color: var(--fg);
  }

  .info-desc {
    margin: 0;
    font-size: 0.95rem;
    color: var(--fg-muted);
    line-height: 1.6;
  }

  .info-arrow {
    color: var(--fg-muted);
    font-size: 1.2rem;
    transition: transform 0.2s, color 0.2s;
  }
  .info:hover .info-arrow {
    transform: translateX(4px);
    color: var(--accent);
  }

  @media (max-width: 560px) {
    .project-block {
      grid-template-columns: 1fr;
      min-height: 0;
      gap: 1rem;
    }
    .silhouette {
      max-width: 220px;
    }
  }
</style>
