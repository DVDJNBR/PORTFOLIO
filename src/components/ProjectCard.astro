---
interface Props {
  title: string;
  description: string;
  url: string;
  tags: string[];
  backdrop?: string | null;
  depth?: string | null;
}

const { title, description, url, tags, backdrop = null, depth = null } = Astro.props;
---

<div class="project-block">
  <div class="visual">
    {depth && <img src={depth} alt="" class="silhouette-depth" />}
    {backdrop && <img src={backdrop} alt="" class="silhouette" />}
  </div>

  <a href={url} target="_blank" rel="noopener noreferrer" class="info">
    <span class="fighter-name">{title}</span>
    <span class="name-rule"></span>
    <p class="info-desc">{description}</p>
    <div class="info-tags">
      {tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
    <span class="info-arrow">→</span>
  </a>
</div>

<style>
  .project-block {
    position: relative;
    width: 100%;
    max-width: 1040px;
    aspect-ratio: 2 / 1;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .visual {
    position: absolute;
    inset: 0;
    width: 66.6667%;
    z-index: 0;
  }

  .silhouette {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: perspective(1400px) rotateY(-10deg);
    transform-origin: right center;
    z-index: 1;
  }

  .silhouette-depth {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: perspective(1400px) rotateY(-10deg) translateX(-14px);
    transform-origin: right center;
    z-index: 0;
  }

  .info {
    position: absolute;
    top: 20px;
    right: 20px;
    height: 66.6667%;
    left: calc(66.6667% - 40px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.5rem;
    text-decoration: none;
    color: inherit;
    padding: 1.75rem;
    box-sizing: border-box;
    z-index: 1;
    overflow: hidden;
    background: rgba(8, 8, 10, 0.7);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0;
    box-shadow:
      -10px 12px 30px rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(255, 255, 255, 0.03) inset;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .info::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.05) 0px,
      rgba(255, 255, 255, 0.05) 1px,
      transparent 1px,
      transparent 3px
    );
    mix-blend-mode: overlay;
    opacity: 0.5;
  }
  .info > * {
    position: relative;
    z-index: 1;
  }
  .info:hover {
    border-color: rgba(255, 255, 255, 0.24);
  }

  .fighter-name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.35rem;
    line-height: 1.15;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: #ffffff;
    text-shadow: 0 0 14px color-mix(in srgb, var(--accent) 70%, transparent), 0 2px 3px rgba(0, 0, 0, 0.8);
  }

  .name-rule {
    width: 36px;
    height: 2px;
    background: var(--accent);
    box-shadow: 0 0 8px color-mix(in srgb, var(--accent) 80%, transparent);
  }

  .info-desc {
    margin: 0;
    font-size: 0.82rem;
    color: #d4d4d8;
    line-height: 1.5;
  }

  .info-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem;
  }

  .tag {
    font-size: 0.62rem;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.08);
    color: #d8d8dc;
    border: 1px solid rgba(255, 255, 255, 0.14);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .info-arrow {
    color: var(--accent);
    font-size: 1.2rem;
    transition: transform 0.2s, color 0.2s;
  }
  .info:hover .info-arrow {
    transform: translateX(4px);
    color: #ffffff;
  }

  @media (max-width: 700px) {
    .project-block {
      aspect-ratio: auto;
      height: 100%;
    }

    .visual {
      position: absolute;
      inset: 0;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .silhouette-depth {
      display: none;
    }

    .silhouette {
      position: static;
      width: auto;
      max-width: 220px;
      height: auto;
      object-fit: contain;
      transform: none;
    }

    .info {
      position: absolute;
      top: 50%;
      right: 0;
      left: auto;
      bottom: auto;
      height: auto;
      width: auto;
      max-width: calc(100% - 1.5rem);
      transform: translateY(-50%);
    }
  }
</style>
