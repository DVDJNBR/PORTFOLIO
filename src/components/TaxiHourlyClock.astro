---
// Courses de taxi NYC par heure (data/aggregates/hourly.parquet, ~75M courses)
// Chaque heure = un immeuble stylisé (silhouette skyline), disposé en cadran.
interface Props {
  night?: boolean;
}
const { night = false } = Astro.props;
const r0 = 36;
const buildings = [
  { h: 0, angle: -90.0, color: '#41769b', L: 38.15, tiers: [[0, 38.15, 9.52], [38.15, 1.14, 6.66]], peak: false },
  { h: 1, angle: -75.0, color: '#3b6080', L: 29.25, tiers: [[0, 18.13, 9.42], [18.13, 11.12, 5.18]], peak: false },
  { h: 2, angle: -60.0, color: '#38516f', L: 23.45, tiers: [[0, 11.73, 9.55], [11.73, 6.57, 5.73], [18.3, 5.15, 2.87]], peak: false },
  { h: 3, angle: -45.0, color: '#354863', L: 19.81, tiers: [[0, 19.81, 9.85], [19.81, 0.59, 6.89]], peak: false },
  { h: 4, angle: -30.0, color: '#34445e', L: 18.0, tiers: [[0, 11.16, 8.29], [11.16, 6.84, 4.56]], peak: false },
  { h: 5, angle: -15.0, color: '#34455f', L: 18.45, tiers: [[0, 9.23, 8.89], [9.23, 5.17, 5.33], [14.4, 4.05, 2.67]], peak: false },
  { h: 6, angle: 0.0, color: '#395573', L: 25.02, tiers: [[0, 25.02, 9.96], [25.02, 0.75, 6.97]], peak: false },
  { h: 7, angle: 15.0, color: '#407195', L: 36.13, tiers: [[0, 22.4, 9.37], [22.4, 13.73, 5.15]], peak: false },
  { h: 8, angle: 30.0, color: '#4687b0', L: 44.95, tiers: [[0, 22.48, 10.61], [22.48, 12.59, 6.37], [35.07, 9.88, 3.18]], peak: false },
  { h: 9, angle: 45.0, color: '#488db8', L: 47.58, tiers: [[0, 47.58, 11.38], [47.58, 1.43, 7.97]], peak: false },
  { h: 10, angle: 60.0, color: '#4992be', L: 49.55, tiers: [[0, 30.72, 12.1], [30.72, 18.83, 6.66]], peak: false },
  { h: 11, angle: 75.0, color: '#4b99c7', L: 52.5, tiers: [[0, 26.25, 10.89], [26.25, 14.7, 6.53], [40.95, 11.55, 3.27]], peak: false },
  { h: 12, angle: 90.0, color: '#4da3d2', L: 56.28, tiers: [[0, 56.28, 11.75], [56.28, 1.69, 8.22]], peak: false },
  { h: 13, angle: 105.0, color: '#4fa7d8', L: 58.25, tiers: [[0, 36.12, 12.47], [36.12, 22.13, 6.86]], peak: false },
  { h: 14, angle: 120.0, color: '#51b0e2', L: 61.6, tiers: [[0, 30.8, 11.29], [30.8, 17.25, 6.77], [48.05, 13.55, 3.39]], peak: false },
  { h: 15, angle: 135.0, color: '#52b4e8', L: 63.29, tiers: [[0, 63.29, 11.99], [63.29, 1.9, 8.39]], peak: false },
  { h: 16, angle: 150.0, color: '#52b3e7', L: 63.05, tiers: [[0, 39.09, 12.54], [39.09, 23.96, 6.9]], peak: false },
  { h: 17, angle: 165.0, color: '#55c0f7', L: 68.26, tiers: [[0, 34.13, 13.51], [34.13, 19.11, 8.11], [53.24, 15.02, 4.05]], peak: true },
  { h: 18, angle: 180.0, color: '#57c7ff', L: 71.0, tiers: [[0, 71.0, 12.29], [71.0, 2.13, 8.6]], peak: true },
  { h: 19, angle: 195.0, color: '#53b7ec', L: 64.62, tiers: [[0, 40.06, 12.38], [40.06, 24.56, 6.81]], peak: true },
  { h: 20, angle: 210.0, color: '#51b0e3', L: 61.63, tiers: [[0, 30.81, 12.72], [30.81, 17.26, 7.63], [48.07, 13.56, 3.82]], peak: false },
  { h: 21, angle: 225.0, color: '#52b3e6', L: 62.84, tiers: [[0, 62.84, 11.38], [62.84, 1.89, 7.97]], peak: false },
  { h: 22, angle: 240.0, color: '#4fabdc', L: 59.52, tiers: [[0, 36.9, 11.7], [36.9, 22.62, 6.44]], peak: false },
  { h: 23, angle: 255.0, color: '#4991bd', L: 49.18, tiers: [[0, 24.59, 11.5], [24.59, 13.77, 6.9], [38.36, 10.82, 3.45]], peak: false },
];

function windowsFor(start: number, len: number, width: number) {
  if (len < 6 || width < 4) return [];
  const margin = 2.4;
  const rowGap = 4.3;
  const usable = len - margin * 2;
  const rows = Math.max(1, Math.floor(usable / rowGap) + 1);
  const halfW = width / 2 - 1.3;
  const cols = halfW > 1.5 ? [-halfW * 0.55, halfW * 0.55] : [0];
  const pts: { x: number; y: number }[] = [];
  for (let r = 0; r < rows; r++) {
    const d = rows === 1 ? usable / 2 : (usable * r) / (rows - 1);
    for (const c of cols) {
      pts.push({ x: r0 + start + margin + d, y: c });
    }
  }
  return pts;
}

// Dégradé continu sur 24h (nuit bleu-ardoise -> aube -> matin pêche -> jour neutre -> soir ambre -> crépuscule violet -> nuit).
// Interpolé heure par heure entre des ancres, pas de blocs francs : la teinte glisse en douceur d'une heure à l'autre.
const hourColors = [
  '#3d4356', '#3c4153', '#3b4050', '#3a3e4d', '#393c4a', '#525061',
  '#6b6478', '#8a8086', '#a89d94', '#a49c95', '#a19c97', '#9d9b98',
  '#9f9d9b', '#a1a09d', '#a3a2a0', '#a39a94', '#a39387', '#a38b7b',
  '#9e8476', '#997d70', '#846e74', '#6f5f78', '#60546e', '#504965',
];

function grayFor(h: number) {
  return hourColors[h % 24];
}

const glassPalette = ['#303b40', '#373b3e', '#494e51', '#34393c'];
const glassFor = (h: number) => glassPalette[(h + 2) % glassPalette.length];

// Probabilité de fenêtres allumées par heure : beaucoup la nuit, un peu à l'aube/au crépuscule, rien en journée
// (les lumières intérieures ne se voient pas en plein jour). Basé sur le moment, pas sur le volume de courses.
const nightProb = [
  0.55, 0.6, 0.65, 0.65, 0.55, 0.4, // 0h-5h : nuit
  0.25, 0.15, 0.08, 0.04, // 6h-9h : matin
  0, 0, 0, 0, 0, 0, 0, // 10h-16h : journée
  0.04, 0.08, 0.15, 0.22, // 17h-20h : soir
  0.3, 0.4, 0.5, // 21h-23h : soirée
];

// Hash déterministe (pas de random réel : même rendu à chaque build) pour décider quelles fenêtres sont allumées.
function hashUnit(seed: number) {
  const x = Math.sin(seed) * 43758.5453;
  return x - Math.floor(x);
}

function isLit(h: number, x: number, y: number) {
  const prob = nightProb[h % 24];
  const roll = hashUnit(h * 12.9898 + x * 3.71 + y * 7.13);
  return roll < prob;
}
---

<div class="taxi-clock">
  <svg viewBox="0 0 240 240" role="img" aria-label="Courses de taxi par heure à New York — pic vers 18h, creux vers 4h du matin">
    <circle class="ring-outer" cx="120" cy="120" r="115" />
    <circle class="ring-inner" cx="120" cy="120" r="36" />

    {buildings.map((b) => {
      const bodyColor = grayFor(b.h);
      return (
        <g class="building" transform={`translate(120 120) rotate(${b.angle})`}>
          {b.tiers.map(([start, len, width]) => (
            <rect class="building-body" fill={bodyColor} x={r0 + start} y={-width / 2} width={len} height={width} />
          ))}

          {b.tiers.map(([start, len, width]) =>
            windowsFor(start, len, width).map((p) => {
              const lit = night && isLit(b.h, p.x, p.y);
              return (
                <circle
                  class={lit ? 'window window-lit' : 'window'}
                  fill={lit ? undefined : glassFor(b.h)}
                  cx={p.x}
                  cy={p.y}
                  r="0.55"
                />
              );
            })
          )}

          {b.peak && <line class="spire" stroke={bodyColor} x1={r0 + b.L} y1="0" x2={r0 + b.L + 9} y2="0" />}
        </g>
      );
    })}
  </svg>
</div>

<style>
  .taxi-clock {
    position: absolute;
    inset: -60px 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .taxi-clock svg {
    transform: translateX(17%);
  }

  .ring-outer,
  .ring-inner {
    fill: none;
    stroke: var(--border);
    stroke-width: 1;
  }

  .ring-inner {
    stroke: color-mix(in srgb, var(--accent) 25%, var(--border));
  }

  .window {
    opacity: 0.85;
  }

  .window-lit {
    fill: var(--accent-gold);
    opacity: 0.95;
  }

  .spire {
    stroke-width: 1.2;
  }
</style>
