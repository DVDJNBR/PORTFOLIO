---
import { dayNames, sources, production, consumption } from '../data/watt-watcher-week';

// Mix électrique national français sur une semaine réelle complète (2026-07-01 → 2026-07-07,
// 168h), moyenne horaire nationale — données publiques RTE (ODRE, dataset eco2mix-national-tr).
// Version empilée : chaque source est une bande (sous-stack) dans la pile de production totale,
// + la consommation en ligne au-dessus (l'écart visible = le surplus exporté).
const N = 168;
const slotWidth = 4;
const stripWidth = slotWidth * N;
const groundY = 84;
const viewW = 380;
const viewBoxY0 = -36;
const viewH = 130;
const rightFadeStart = viewW * 0.63;
const leftCoverEnd = 3;
const chartHeight = 100;

function xFor(h: number) {
  return h * slotWidth + slotWidth / 2;
}

// cumul empilé par heure, dans l'ordre de `sources` (base = nucléaire, sommet = solaire)
const cumulative: number[][] = Array.from({ length: N }, (_, h) => {
  let acc = 0;
  return sources.map((s) => (acc += production[s.key][h]));
});
const productionTotal = cumulative.map((c) => c[c.length - 1]);

const maxMW = Math.max(...productionTotal, ...consumption);
const heightScale = chartHeight / maxMW;

function yFor(mw: number) {
  return groundY - mw * heightScale;
}

// Jonction : la bande défile en 3 copies bout à bout (heure 167 d'une copie touche l'heure 0 de
// la suivante). On ajoute un point de fermeture par série, à la position "heure 168", avec la
// valeur réelle de l'heure 0 — la courbe/bande se referme donc exactement sans saut ni décalage
// visible au raccord, plutôt que d'être coupée net à 167.
function closedSeries(valueAt: (h: number) => number) {
  const pts = Array.from({ length: N }, (_, h) => [xFor(h), yFor(valueAt(h))] as const);
  pts.push([xFor(N), yFor(valueAt(0))]);
  return pts;
}

// Lissage Catmull-Rom → Bézier : des courbes douces entre les points horaires plutôt que des
// segments droits, pour un rendu plus "Apple" (Health/Activity) que graphique de données brut.
type Pt = readonly [number, number];
function bezierSegments(points: readonly Pt[]) {
  const n = points.length;
  let s = '';
  for (let i = 0; i < n - 1; i++) {
    const p0 = points[Math.max(i - 1, 0)];
    const p1 = points[i];
    const p2 = points[i + 1];
    const p3 = points[Math.min(i + 2, n - 1)];
    const cp1x = p1[0] + (p2[0] - p0[0]) / 6;
    const cp1y = p1[1] + (p2[1] - p0[1]) / 6;
    const cp2x = p2[0] - (p3[0] - p1[0]) / 6;
    const cp2y = p2[1] - (p3[1] - p1[1]) / 6;
    s += ` C ${cp1x.toFixed(2)},${cp1y.toFixed(2)} ${cp2x.toFixed(2)},${cp2y.toFixed(2)} ${p2[0].toFixed(2)},${p2[1].toFixed(2)}`;
  }
  return s;
}
function smoothOpenPath(points: readonly Pt[]) {
  return `M ${points[0][0].toFixed(2)},${points[0][1].toFixed(2)}${bezierSegments(points)}`;
}

function bandPath(bandIndex: number) {
  const topOf = (h: number) => cumulative[h][bandIndex];
  const bottomOf = (h: number) => (bandIndex === 0 ? 0 : cumulative[h][bandIndex - 1]);
  const topPts = closedSeries(topOf);
  const bottomPtsReversed = [...closedSeries(bottomOf)].reverse();
  return `${smoothOpenPath(topPts)} L ${bottomPtsReversed[0][0].toFixed(2)},${bottomPtsReversed[0][1].toFixed(2)}${bezierSegments(bottomPtsReversed)} Z`;
}

const consumptionPath = smoothOpenPath(closedSeries((h) => consumption[h]));

// Teinte plus claire en haut de chaque bande pour un léger effet de profondeur/verre.
function lighten(hex: string, amt: number) {
  const c = hex.replace('#', '');
  const r = parseInt(c.slice(0, 2), 16);
  const g = parseInt(c.slice(2, 4), 16);
  const b = parseInt(c.slice(4, 6), 16);
  const mix = (v: number) => Math.round(v + (255 - v) * amt);
  return `#${[mix(r), mix(g), mix(b)].map((v) => v.toString(16).padStart(2, '0')).join('')}`;
}

const legendEntries = [
  ...sources.map((s) => ({ label: s.label, color: s.color, dashed: false })),
  { label: 'Consommation', color: '#ef4444', dashed: true },
];
---

<div class="ww-chart">
  <svg viewBox={`0 ${viewBoxY0} ${viewW} ${viewH}`} role="img" aria-label="Mix électrique français sur une semaine — production par source (empilée) vs consommation, 1-7 juillet 2026">
    <defs>
      <linearGradient id="wwRightFade" x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="var(--bg)" stop-opacity="0" />
        <stop offset="1" stop-color="var(--bg)" stop-opacity="1" />
      </linearGradient>
      <filter id="wwGlow" x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur stdDeviation="1.1" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
      {sources.map((s) => (
        <linearGradient id={`ww-grad-${s.key}`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color={lighten(s.color, 0.22)} />
          <stop offset="100%" stop-color={s.color} />
        </linearGradient>
      ))}
    </defs>

    <g class="ww-scroll">
      {[0, 1, 2].map((rep) => (
        <g transform={`translate(${rep * stripWidth} 0)`}>
          {sources.map((s, i) => (
            <path d={bandPath(i)} fill={`url(#ww-grad-${s.key})`} class="ww-band" />
          ))}
          <path d={consumptionPath} class="ww-conso-line" filter="url(#wwGlow)" />
          {dayNames.map((_, d) => (
            <line x1={xFor(d * 24)} y1={groundY - chartHeight} x2={xFor(d * 24)} y2={groundY} class="ww-day-divider" />
          ))}
          {dayNames.map((name, d) => (
            <text class="ww-hour-label" x={xFor(d * 24 + 12)} y={groundY + 8}>
              {name}
            </text>
          ))}
        </g>
      ))}
    </g>

    <g class="ww-axis">
      <line x1="3" y1={groundY} x2="3" y2={groundY - chartHeight} class="ww-axis-line" />
      <line x1="1.5" y1={groundY} x2="4.5" y2={groundY} class="ww-axis-tick" />
      <text class="ww-axis-label" x="2.5" y={groundY + 1.5} style="text-anchor:end">0</text>
      <line x1="1.5" y1={groundY - chartHeight} x2="4.5" y2={groundY - chartHeight} class="ww-axis-tick" />
      <text class="ww-axis-label" x="6" y={groundY - chartHeight + 1.5}>{Math.round(maxMW / 1000)} GW</text>
    </g>

    <rect class="ww-left-cover" x="0" y={viewBoxY0} width={leftCoverEnd} height={viewH} />
    <rect x={rightFadeStart} y={viewBoxY0} width={viewW - rightFadeStart} height={viewH} fill="url(#wwRightFade)" />

    <g class="ww-legend">
      {legendEntries.map((e, i) => {
        const col = i % 4;
        const row = Math.floor(i / 4);
        const x = 6 + col * 55;
        const y = viewBoxY0 + 6 + row * 5;
        return (
          <g transform={`translate(${x} ${y})`}>
            <line
              x1="-1.6"
              y1="0"
              x2="1.6"
              y2="0"
              stroke={e.color}
              stroke-width={e.dashed ? 0.9 : 1.6}
              stroke-dasharray={e.dashed ? '1.3 1' : undefined}
            />
            <text x="3" y="1.1" class="ww-legend-label">{e.label}</text>
          </g>
        );
      })}
    </g>
  </svg>
</div>

<style>
  .ww-chart {
    position: absolute;
    inset: -30px -50% -30px 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ww-chart svg {
    width: 100%;
    height: 100%;
  }

  .ww-band {
    opacity: 0.92;
  }

  .ww-conso-line {
    fill: none;
    stroke: #ef4444;
    stroke-width: 1.4;
    stroke-linejoin: round;
    stroke-dasharray: 2.6 1.8;
    opacity: 1;
  }

  .ww-scroll {
    animation: ww-drift 90s linear infinite;
  }

  @keyframes ww-drift {
    to {
      transform: translateX(-672px);
    }
  }

  .ww-day-divider {
    stroke: #8ea0c2;
    stroke-width: 0.3;
    opacity: 0.16;
  }

  .ww-hour-label {
    font-family: var(--font-display);
    font-size: 3.6px;
    fill: var(--fg-muted);
    opacity: 0.6;
    text-anchor: middle;
  }

  .ww-left-cover {
    fill: var(--bg);
  }

  .ww-axis-line,
  .ww-axis-tick {
    stroke: var(--fg-muted);
    stroke-width: 0.35;
    opacity: 0.45;
  }

  .ww-axis-label {
    font-family: var(--font-display);
    font-size: 3.2px;
    fill: var(--fg-muted);
    opacity: 0.7;
  }

  .ww-legend-label {
    font-family: var(--font-display);
    font-size: 3px;
    fill: var(--fg-muted);
    opacity: 0.8;
  }

  @media (prefers-reduced-motion: reduce) {
    .ww-scroll {
      animation: none;
    }
  }
</style>
