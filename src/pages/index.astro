---
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TaxiHourlyClock from '../components/TaxiHourlyClock.astro';
import WattWatcherChart from '../components/WattWatcherChart.astro';

const entries = await getCollection('projects');
entries.sort((a, b) => b.data.order - a.data.order);

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '../content/projects/*/assets/*.{png,jpg,jpeg,webp,avif}'
);

interface ProjectAssets {
  icon: string | null;
  backdrop: string | null;
  depth: string | null;
}

function splitAssets(named: { name: string; url: string }[]): ProjectAssets {
  let icon: string | null = null;
  let backdrop: string | null = null;
  let depth: string | null = null;

  for (const { name, url } of named) {
    const base = name.replace(/\.[^.]+$/, '').toLowerCase();
    if (base === 'icon-selection') {
      icon = url;
    } else if (base === 'transparent-selection') {
      backdrop = url;
    } else if (base === 'depth-selection') {
      depth = url;
    }
  }

  return { icon, backdrop, depth };
}

const projectAssets: Record<string, ProjectAssets> = {};
for (const entry of entries) {
  const folder = entry.id.split('/')[0];
  const matches = Object.entries(allImages).filter(([p]) => p.includes(`/projects/${folder}/assets/`));

  const named: { name: string; url: string }[] = [];
  for (const [path, load] of matches) {
    const mod = await load();
    named.push({ name: path.split('/').pop() ?? '', url: mod.default.src });
  }
  projectAssets[entry.id] = splitAssets(named);
}

const preloadImages = Object.values(projectAssets).flatMap((a) =>
  [a.backdrop, a.icon, a.depth].filter((url): url is string => Boolean(url))
);
---

<Layout preloadImages={preloadImages}>
  <div class="page">
    <header class="banner">
      <div class="banner-identity">
        <span class="brand-name">David Breau</span>
        <span class="brand-role">Portfolio · Data Engineer/Analyst</span>
      </div>
      <div class="banner-actions">
        <div class="banner-stats">
          <a
            href="https://www.codewars.com/users/DVDJNBR"
            target="_blank"
            rel="noopener noreferrer"
            class="codewars-badge"
          >
            <img src="https://www.codewars.com/users/DVDJNBR/badges/micro" alt="Codewars — DVDJNBR" loading="lazy" />
          </a>
          <a
            href="https://www.duolingo.com/profile/d4v1dbr34u"
            target="_blank"
            rel="noopener noreferrer"
            class="duolingo-badge"
          >
            <svg width="128" height="20" viewBox="0 0 128 20" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Duolingo — 964 jours, 44 260 xp">
              <defs>
                <clipPath id="duoClip">
                  <path d="M5.774 0H122.226L128 10L122.226 20H5.774L0 10Z" />
                </clipPath>
              </defs>
              <path d="M5.774 0H122.226L128 10L122.226 20H5.774L0 10Z" fill="#303133" />
              <g clip-path="url(#duoClip)">
                <image href="/img/duolingo-icon.png" x="2" y="1.5" width="17" height="17" />
                <g transform="translate(13.01 0.67) scale(0.2157)">
                  <path d="M64.9961 71.0004C73.6878 71.0004 80.7341 66.9588 80.7341 61.9733C80.7341 56.9877 73.6878 52.9458 64.9961 52.9458C56.3043 52.9458 49.2584 56.9874 49.2584 61.9733C49.2584 66.9592 56.3043 71.0004 64.9961 71.0004Z" fill="#FFC800" fill-opacity="0.33"/>
                  <path d="M62.0861 17.4185C63.5862 15.5272 66.4576 15.5272 67.9578 17.4185L81.5015 32.9533C84.3168 36.3914 85.9968 40.7315 85.9968 45.4496C85.9968 56.6044 76.6059 65.6474 65.0221 65.6474C53.4383 65.6474 44.0474 56.6044 44.0474 45.4496V43.2719L44 26.2204C43.9929 23.7172 45.492 21.7346 47.8219 22.1271C48.2864 22.2052 49.2679 22.5011 49.7077 22.7364L54.5574 25.0175L62.0861 17.4181V17.4185Z" fill="#FF9600"/>
                  <path d="M66.735 37.1506C65.9976 36.1464 64.4975 36.1464 63.7601 37.1506L58.4655 42.462C53.5496 47.8986 57.811 57.0045 65.3191 56.7946C73.0145 57.0563 77.311 47.3049 71.7753 42.1162L66.735 37.1506Z" fill="#FFC800"/>
                </g>
                <text x="34.5" y="15" font-family="Lato, Helvetica Neue, Helvetica, Arial, sans-serif" font-size="12" font-weight="700" fill="#FF9600" data-duolingo-streak>964</text>
                <text x="61.5" y="14.5" font-family="Lato, Helvetica Neue, Helvetica, Arial, sans-serif" font-size="10" fill="#8A8A8A">·</text>
                <g transform="translate(67.5 4) scale(0.4)">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M14.0367 2.67272C13.8379 0.718003 11.3282 0.0455378 10.1787 1.63898L0.717665 14.7538C-0.157342 15.9667 0.452676 17.6801 1.89732 18.0672L7.2794 19.5093L8.07445 27.3273C8.27323 29.282 10.7829 29.9545 11.9324 28.361L21.3935 15.2462C22.2685 14.0333 21.6585 12.3199 20.2138 11.9328L14.8317 10.4907L14.0367 2.67272Z" fill="#FFD900"/>
                  <path d="M2.574 16.4882C2.08457 16.3561 2.03731 15.6803 2.50359 15.4813L6.24415 13.8853C6.58188 13.7412 6.96093 13.973 6.98654 14.3393L7.17226 16.9952C7.19787 17.3615 6.85477 17.6438 6.50027 17.5481L2.574 16.4882Z" fill="#F7C100"/>
                  <path d="M19.717 13.2505C20.2064 13.3826 20.2537 14.0584 19.7874 14.2573L16.0469 15.8533C15.7091 15.9974 15.3301 15.7656 15.3045 15.3993L15.1188 12.7435C15.0931 12.3772 15.4362 12.0949 15.7907 12.1906L19.717 13.2505Z" fill="#FFEF8F"/>
                </g>
                <text x="80" y="15" font-family="Lato, Helvetica Neue, Helvetica, Arial, sans-serif" font-size="12" fill="#E8E8E8" data-duolingo-xp>44,260</text>
              </g>
            </svg>
          </a>
        </div>
        <div class="social-links">
          <a href="https://www.linkedin.com/in/david-breau" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="https://x.com/d4v1dbr34u/all" target="_blank" rel="noopener noreferrer">Twitter</a>
        </div>
      </div>
    </header>

    <main class="main">
      <section class="projects">
        <div class="stage">
          <div class="detail-stage">
            {entries.map((entry, i) => (
              <div class="detail-slot" data-index={i}>
                <ProjectCard
                  title={entry.data.title}
                  description={entry.data.description}
                  url={entry.data.url}
                  tags={entry.data.tags}
                  backdrop={projectAssets[entry.id]?.backdrop}
                  depth={projectAssets[entry.id]?.depth}
                  accent={entry.data.accent}
                >
                  {entry.id.startsWith('nyc-taxi') && (
                    <Fragment slot="visual">
                      <TaxiHourlyClock />
                    </Fragment>
                  )}
                  {entry.id.startsWith('watt-watcher') && (
                    <Fragment slot="visual">
                      <WattWatcherChart />
                    </Fragment>
                  )}
                </ProjectCard>
              </div>
            ))}
          </div>

          <div class="select-panel">
            <span class="select-label">Projets</span>
            <div class="select-grid" role="listbox" aria-label="Sélection de projet">
              {entries.map((entry, i) => (
                <button
                  type="button"
                  class="select-cell"
                  data-index={i}
                  role="option"
                  title={entry.data.title}
                  aria-label={entry.data.title}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  style={entry.data.accent ? `--cell-glow: ${entry.data.accent};` : undefined}
                >
                  <span class="select-cell-glow" aria-hidden="true"></span>
                  <span class="select-cell-name">{entry.data.title}</span>
                </button>
              ))}
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>
</Layout>

<style>
  .page {
    max-width: 1250px;
    height: 100dvh;
    margin: 0 auto;
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .banner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: nowrap;
    gap: 0.75rem;
    margin: -1.25rem -1.5rem 1.25rem;
    padding: 1rem 1.5rem;
    background: color-mix(in srgb, var(--bg) 65%, transparent);
    backdrop-filter: saturate(160%) blur(20px);
    -webkit-backdrop-filter: saturate(160%) blur(20px);
    border-bottom: 1px solid var(--border);
  }

  .banner-identity {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.3rem;
    letter-spacing: -0.01em;
    color: var(--fg);
  }
  .brand-role {
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    color: var(--fg-muted);
  }

  .banner-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .brand-role {
      display: none;
    }
    .banner-actions {
      gap: 0.35rem;
    }
    .social-links {
      gap: 0.6rem;
    }
  }

  .banner-stats {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6px;
  }

  .codewars-badge {
    display: flex;
    align-items: center;
    line-height: 0;
    opacity: 0.9;
    transition: opacity 0.2s var(--ease-apple);
  }
  .codewars-badge:hover {
    opacity: 1;
  }
  .codewars-badge img {
    display: block;
    height: 20px;
    width: auto;
  }

  .duolingo-badge {
    display: flex;
    align-items: center;
    line-height: 0;
    opacity: 0.9;
    transition: opacity 0.2s var(--ease-apple);
  }
  .duolingo-badge:hover {
    opacity: 1;
  }
  .duolingo-badge svg {
    display: block;
    height: 20px;
    width: auto;
  }

  .social-links {
    display: flex;
    gap: 1rem;
  }
  .social-links a {
    color: var(--fg-muted);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.85rem;
    letter-spacing: -0.01em;
    transition: color 0.2s var(--ease-apple);
  }
  .social-links a:hover {
    color: var(--accent);
  }

  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .projects {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 0;
  }

  .stage {
    position: relative;
    width: 100%;
    max-width: 1040px;
    aspect-ratio: 2 / 1;
    margin: 0 auto;
    flex-shrink: 0;
  }

  .select-panel {
    position: absolute;
    left: calc(66.6667% - 40px);
    right: 20px;
    bottom: 55px;
    transform: translateY(50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .select-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-muted);
  }

  .select-grid {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  @media (max-width: 420px) {
    .stage {
      display: flex;
      flex-direction: column;
    }

    .select-panel {
      position: static;
      transform: none;
      width: auto;
      max-width: none;
      margin: 0.5rem auto 0;
      order: 2;
    }

    .detail-stage {
      flex: 1;
      order: 1;
    }
  }

  .select-cell {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: none;
    border: none;
    padding: 0.15rem 0;
    cursor: pointer;
    font: inherit;
    color: var(--fg-muted);
    text-align: left;
    transition: color 0.25s var(--ease-apple);
  }

  .select-cell-glow {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
    background: var(--cell-glow, var(--accent-gold));
    opacity: 0.3;
    box-shadow: 0 0 0 0 var(--cell-glow, var(--accent-gold));
    transition: opacity 0.25s var(--ease-apple), box-shadow 0.25s var(--ease-apple);
  }

  .select-cell-name {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .select-cell.is-glowing {
    color: var(--fg);
  }

  .select-cell.is-glowing .select-cell-glow {
    opacity: 1;
    box-shadow: 0 0 10px 2px var(--cell-glow, var(--accent-gold));
  }

  .select-cell.is-glowing .select-cell-name {
    text-shadow: 0 0 18px color-mix(in srgb, var(--cell-glow, var(--accent-gold)) 55%, transparent);
  }

  .detail-stage {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .detail-slot {
    display: none;
    position: absolute;
    inset: 0;
  }

  .detail-slot.is-active {
    display: block;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const cells = Array.from(document.querySelectorAll('.select-cell')) as HTMLButtonElement[];
    const slots = Array.from(document.querySelectorAll('.detail-slot')) as HTMLElement[];

    if (slots.length === 0) return;

    let confirmedIndex = 0;

    const showSlot = (index: number) => {
      slots.forEach((slot) => {
        slot.classList.toggle('is-active', Number(slot.dataset.index) === index);
      });
      cells.forEach((cell) => {
        cell.classList.toggle('is-glowing', Number(cell.dataset.index) === index);
      });
    };

    const select = (index: number) => {
      confirmedIndex = index;
      cells.forEach((cell) => {
        cell.setAttribute('aria-selected', String(Number(cell.dataset.index) === index));
      });
      showSlot(index);
    };

    cells.forEach((cell) => {
      cell.addEventListener('click', () => {
        select(Number(cell.dataset.index));
      });
      cell.addEventListener('mouseenter', () => {
        showSlot(Number(cell.dataset.index));
      });
    });

    const grid = document.querySelector('.select-grid');
    grid?.addEventListener('mouseleave', () => {
      showSlot(confirmedIndex);
    });

    select(0);

    fetch('/api/duolingo')
      .then((res) => (res.ok ? res.json() : Promise.reject()))
      .then((data: { users?: { streak?: number; totalXp?: number }[] }) => {
        const user = data.users?.[0];
        const streakEl = document.querySelector('[data-duolingo-streak]');
        const xpEl = document.querySelector('[data-duolingo-xp]');
        if (streakEl && typeof user?.streak === 'number') {
          streakEl.textContent = String(user.streak);
        }
        if (xpEl && typeof user?.totalXp === 'number') {
          xpEl.textContent = user.totalXp.toLocaleString('en-US');
        }
      })
      .catch(() => {
        // relais nginx pas encore en place / indisponible : on garde les valeurs statiques
      });
  });
</script>
