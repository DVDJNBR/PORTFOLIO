---
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const entries = await getCollection('projects');
entries.sort((a, b) => b.data.order - a.data.order);

// Auto-populated from every project's tags — never hand-maintained, so it
// can't drift out of sync with what the projects actually list.
const allTags = [...new Set(entries.flatMap((e) => e.data.tags))].sort((a, b) =>
  a.localeCompare(b)
);

// Shields.io logo badges, styled per github.com/ileriayo/markdown-badges.
// Azure, Azure Functions, Delta Lake and dbt aren't in that repo's set —
// built to match its same for-the-badge convention.
const TAG_BADGES: Record<string, string> = {
  Python: 'https://img.shields.io/badge/python-%233670A0.svg?style=for-the-badge&logo=python&logoColor=ffdd54',
  Databricks: 'https://img.shields.io/badge/Databricks-%23FF3621.svg?style=for-the-badge&logo=databricks&logoColor=white',
  Azure: 'https://img.shields.io/badge/azure-%230078D4.svg?style=for-the-badge&logo=microsoftazure&logoColor=white',
  'Azure Functions': 'https://img.shields.io/badge/Azure%20Functions-%230062AD.svg?style=for-the-badge&logo=azurefunctions&logoColor=white',
  'Delta Lake': 'https://img.shields.io/badge/Delta%20Lake-00ADD8.svg?style=for-the-badge',
  Terraform: 'https://img.shields.io/badge/terraform-%235835CC.svg?style=for-the-badge&logo=terraform&logoColor=white',
  Snowflake: 'https://img.shields.io/badge/snowflake-%2329B5E8.svg?style=for-the-badge&logo=snowflake&logoColor=white',
  dbt: 'https://img.shields.io/badge/dbt-%23FF694B.svg?style=for-the-badge&logo=dbt&logoColor=white',
  Streamlit: 'https://img.shields.io/badge/Streamlit-%23FE4B4B.svg?style=for-the-badge&logo=streamlit&logoColor=white',
  Docker: 'https://img.shields.io/badge/docker-%230db7ed.svg?style=for-the-badge&logo=docker&logoColor=white',
  FastAPI: 'https://img.shields.io/badge/fastapi-%23009688.svg?style=for-the-badge&logo=fastapi&logoColor=white',
  React: 'https://img.shields.io/badge/react-%2320232a.svg?style=for-the-badge&logo=react&logoColor=%2361DAFB',
  Supabase: 'https://img.shields.io/badge/Supabase-%233ECF8E.svg?style=for-the-badge&logo=supabase&logoColor=white',
};
const tagBadge = (tag: string) =>
  TAG_BADGES[tag] ?? `https://img.shields.io/badge/${encodeURIComponent(tag)}-8f8c86.svg?style=for-the-badge`;

// No sharp single-item tip at top/bottom — a circle has a flat-ish chord
// there, not a point — so the shortest rows still carry 2 badges each.
const TAG_ROW_SIZES = [2, 3, 3, 3, 2];
const tagRows: string[][] = [];
{
  let idx = 0;
  for (const size of TAG_ROW_SIZES) {
    tagRows.push(allTags.slice(idx, idx + size));
    idx += size;
  }
}

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '../content/projects/*/assets/*.{png,jpg,jpeg,webp,avif}'
);

interface ProjectAssets {
  icon: string | null;
  backdrop: string | null;
  depth: string | null;
}

function splitAssets(named: { name: string; url: string }[]): ProjectAssets {
  let icon: string | null = null;
  let backdrop: string | null = null;
  let depth: string | null = null;

  for (const { name, url } of named) {
    const base = name.replace(/\.[^.]+$/, '').toLowerCase();
    if (base === 'icon-selection') {
      icon = url;
    } else if (base === 'transparent-selection') {
      backdrop = url;
    } else if (base === 'depth-selection') {
      depth = url;
    }
  }

  return { icon, backdrop, depth };
}

const projectAssets: Record<string, ProjectAssets> = {};
for (const entry of entries) {
  const folder = entry.id.split('/')[0];
  const matches = Object.entries(allImages).filter(([p]) => p.includes(`/projects/${folder}/assets/`));

  const named: { name: string; url: string }[] = [];
  for (const [path, load] of matches) {
    const mod = await load();
    named.push({ name: path.split('/').pop() ?? '', url: mod.default.src });
  }
  projectAssets[entry.id] = splitAssets(named);
}

const preloadImages = Object.values(projectAssets).flatMap((a) =>
  [a.backdrop, a.icon, a.depth].filter((url): url is string => Boolean(url))
);

// Codewars has a real public JSON API (unlike Duolingo, which needed the
// client-side fetch + static-value fallback below) — fetched once here at
// build time, no relay or client JS needed for it to stay accurate.
const CODEWARS_RANK_COLORS: Record<string, string> = {
  white: 'var(--kyu-white)',
  yellow: 'var(--kyu-yellow)',
  blue: 'var(--kyu-blue)',
  purple: 'var(--kyu-purple)',
  red: 'var(--kyu-red)',
  black: 'var(--kyu-black)',
};

let codewars = { rank: '4 kyu', honor: 1257, color: CODEWARS_RANK_COLORS.blue };
try {
  const res = await fetch('https://www.codewars.com/api/v1/users/DVDJNBR');
  if (res.ok) {
    const data = await res.json();
    codewars = {
      rank: data.ranks.overall.name,
      honor: data.honor,
      color: CODEWARS_RANK_COLORS[data.ranks.overall.color] ?? 'var(--fg)',
    };
  }
} catch {
  // Codewars unreachable at build time — keep the last known values above.
}
---

<Layout preloadImages={preloadImages}>
  <div class="site">
    <!-- Persistent across both levels — never scrolls away -->
    <nav class="social-dock" aria-label="Réseaux">
      <a href="https://www.linkedin.com/in/david-breau" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.84-3.03-1.85 0-2.14 1.44-2.14 2.94v5.66H9.37V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/>
        </svg>
      </a>
      <a href="https://github.com/DVDJNBR" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.58 2 12.19c0 4.49 2.87 8.3 6.84 9.64.5.1.68-.22.68-.49 0-.24-.01-.88-.01-1.72-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.89 1.57 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.73 0 0 .84-.28 2.75 1.05a9.29 9.29 0 0 1 5 0c1.9-1.33 2.74-1.05 2.74-1.05.55 1.42.2 2.47.1 2.73.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.79-4.57 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.48-.01 2.81 0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.19C22 6.58 17.52 2 12 2z"/>
        </svg>
      </a>
      <a href="https://x.com/d4v1dbr34u/all" target="_blank" rel="noopener noreferrer" aria-label="Twitter / X">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M18.24 3H21l-6.5 7.43L22.2 21h-6.32l-4.95-6.47L5.2 21H2.44l6.96-7.95L2 3h6.48l4.48 5.92L18.24 3zm-1.1 16.17h1.76L7.94 4.73H6.05l11.09 14.44z"/>
        </svg>
      </a>
    </nav>

    <div class="level-indicator" aria-hidden="true">
      <span class="level-dot is-active" data-level="0"></span>
      <span class="level-dot" data-level="1"></span>
    </div>

    <div class="level-track" id="level-track">
      <!-- ── Niveau 1 — Présentation ─────────────────────────────────── -->
      <section class="level level-presentation" data-level="0">
        <div class="presentation-inner">
          <div class="presentation-card-wrap">
            <div class="presentation-card">
            <span class="kicker">Portfolio</span>
            <div class="name-row">
              <div class="name-avatar">
                <img src="/img/profile.png" alt="David Breau" />
              </div>
              <h1 class="name" id="name-line">David Breau</h1>
            </div>
            <p class="role" id="role-line">Data analyst <span class="role__sep">/</span> Data ingénieur</p>
            <p class="bio">
              Ancien profil événementiel, hôtellerie et vente, j'ai terminé une reconversion en
              data avec un double cursus data analyst / data ingénieur. Je construis des pipelines
              et des architectures cloud pour alimenter vos dashboards.
            </p>
            </div>
          </div>

          <div class="learning-badges">
            <a
              href="https://www.codewars.com/users/DVDJNBR"
              target="_blank"
              rel="noopener noreferrer"
              class="codewars-badge"
              aria-label={`Codewars — ${codewars.rank}, ${codewars.honor} honor`}
            >
              <span class="stat-pill">
                <img src="/img/codewars-icon.png" alt="" width="18" height="18" />
                <span class="stat-rank" style={`color:${codewars.color}`}>{codewars.rank}</span>
                <span class="stat-sep">·</span>
                <span class="stat-score">{codewars.honor.toLocaleString('en-US')}</span>
              </span>
            </a>
            <a
              href="https://www.duolingo.com/profile/d4v1dbr34u"
              target="_blank"
              rel="noopener noreferrer"
              class="duolingo-badge"
              aria-label="Duolingo"
            >
              <span class="stat-pill">
                <img src="/img/duolingo-icon.png" alt="" width="18" height="18" />
                <!-- No hardcoded fallback number — a stale streak/xp is
                     wrong the moment it's out of date, and briefly
                     flashing one on every load before the real fetch
                     resolves looked broken. A dash reads as "loading",
                     never as a wrong number. -->
                <span class="stat-rank" style="color:#FF9600" data-duolingo-streak>–</span>
                <span class="stat-sep">·</span>
                <span class="stat-score" data-duolingo-xp>–</span>
              </span>
            </a>
          </div>

          <div class="tags-panel">
            <div class="tags-circle">
              {tagRows.map((row) => (
                <div class="tags-row">
                  {row.map((tag) => (
                    <img class="tech-tag" src={tagBadge(tag)} alt={tag} loading="lazy" />
                  ))}
                </div>
              ))}
            </div>
          </div>
        </div>

        <button type="button" class="scroll-cue" data-goto="1" aria-label="Voir les projets">
          <span>Projets</span>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M12 4v16M6 14l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </section>

      <!-- ── Niveau 2 — Projets (inchangé) ──────────────────────────────── -->
      <section class="level level-projects" data-level="1">
        <div class="page">
          <main class="main">
            <section class="projects">
              <div class="stage">
                <div class="roulette" data-reveal="left" role="listbox" aria-label="Sélection de projet">
                  <div class="roulette-scroll">
                    <div class="roulette-track">
                      {entries.map((entry, i) => (
                        <button
                          type="button"
                          class="roulette-item"
                          data-index={i}
                          data-accent={entry.data.accent}
                          role="option"
                          aria-selected={i === 0 ? 'true' : 'false'}
                        >
                          {entry.data.title}
                        </button>
                      ))}
                    </div>
                  </div>
                  <span class="roulette-marker" aria-hidden="true"></span>
                </div>

                <div class="detail-stage" data-reveal="right">
                  {entries.map((entry, i) => (
                    <div class="detail-slot" data-index={i}>
                      <ProjectCard
                        title={entry.data.title}
                        description={entry.data.description}
                        url={entry.data.url}
                        tags={entry.data.tags}
                        backdrop={projectAssets[entry.id]?.backdrop}
                        depth={projectAssets[entry.id]?.depth}
                        accent={entry.data.accent}
                        denseVisual={entry.id.startsWith('nyc-taxi') || entry.id.startsWith('watt-watcher')}
                      >
                        {/* Always an explicit Fragment, never a bare conditional — Astro
                            decides whether the "visual" slot is filled per-component, not
                            per-render, so a conditional fragment that resolves to nothing
                            still counts as "filled" and silently kills ProjectCard's own
                            fallback (backdrop/depth) for every other project in this loop. */}
                        <Fragment slot="visual">
                          {entry.id.startsWith('nyc-taxi') ? (
                            <img src="/img/nyc-taxi-chart.png" alt="Courses de taxi par heure à New York" class="silhouette" />
                          ) : entry.id.startsWith('watt-watcher') ? (
                            <img src="/img/watt-watcher-chart.png" alt="Mix électrique français sur une semaine" class="silhouette" />
                          ) : (
                            <>
                              {projectAssets[entry.id]?.depth && (
                                <img src={projectAssets[entry.id].depth} alt="" class="silhouette-depth" />
                              )}
                              {projectAssets[entry.id]?.backdrop && (
                                <img src={projectAssets[entry.id].backdrop} alt="" class="silhouette" />
                              )}
                            </>
                          )}
                        </Fragment>
                      </ProjectCard>
                    </div>
                  ))}
                </div>
              </div>
            </section>
          </main>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .site {
    height: 100dvh;
  }

  /* ── Persistent social dock — a floating pill, centered, above both
       levels — deliberately not in a corner, where it would collide with
       the project card's arrow on niveau 2. ────────────────────────── */
  .social-dock {
    position: fixed;
    top: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 0.55rem 1.4rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    border: 1px solid var(--border);
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    box-shadow: var(--shadow-sm);
  }
  .social-dock a {
    color: var(--fg-muted);
    display: flex;
    transition: color 0.2s var(--ease-apple);
  }
  .social-dock a:hover {
    color: var(--accent-blue);
  }

  /* ── Level indicator ──────────────────────────────────────────────── */
  .level-indicator {
    position: fixed;
    right: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 20;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .level-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--fg-muted);
    opacity: 0.4;
    transition: opacity 0.25s var(--ease-apple), background 0.25s var(--ease-apple);
  }
  .level-dot.is-active {
    opacity: 1;
    background: var(--accent-blue);
  }

  @media (max-width: 480px) {
    .level-indicator {
      display: none;
    }
  }

  /* ── Level track — scroll-snap between the two levels ───────────────── */
  .level-track {
    height: 100dvh;
    overflow-y: auto;
    scroll-snap-type: y mandatory;
    scroll-behavior: smooth;
    /* Gives [data-reveal] elements somewhere to rotate into — without this
       rotateY just flattens instead of turning in depth. */
    perspective: 1400px;
  }

  .level {
    height: 100dvh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  /* ── Niveau 1 : présentation ──────────────────────────────────────── */
  .level-presentation {
    background: var(--bg);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 1.5rem;
    position: relative;
  }

  /* Black + the photo's own blue, tying every accent moment (kicker pill,
     role separator, bio-photo line, orbit glow) back to the same hue —
     that's the "connection" the flat photo+card version was missing. */
  .presentation-inner {
    /* Sampled from the photo itself (average of its opaque pixels) rather
       than a palette color — so the line reads as coming from the photo. */
    --photo-blue: #848de5;
    /* Codewars kyu/dan rank colors — the API only gives a color NAME
       ("blue", "yellow"...), so these are our own hex picks, tuned to sit
       in the same family as the rest of the palette rather than Codewars'
       raw saturated brand colors. */
    --kyu-white: #ece8e0;
    --kyu-yellow: #dfb24a;
    --kyu-blue: #6fa3d8;
    --kyu-purple: #9a7fd4;
    --kyu-red: #d1594a;
    --kyu-black: #d6d3ce;
    position: relative;
    max-width: 1000px;
    margin: -80px auto 0;
    width: 100%;
    display: flex;
    align-items: center;
    /* Used to matter for centering card-wrap+tags-panel as a pair, but
       they always filled the full width anyway (card-wrap's flex-grow
       absorbed whatever was left) so it was already a no-op — until
       tags-panel went absolute/out-of-flow, leaving card-wrap as the
       row's only child and centering it solo, drifting the whole left
       column (photo, name, bio) rightward. */
    justify-content: flex-start;
    gap: 2rem;
  }

  /* Two-thirds content, one-third tags — pulled toward opposite ends of the
     row so the pair reads as a diagonal instead of two centered blocks. */
  .presentation-card-wrap {
    flex: 2 1 0;
    min-width: 0;
    align-self: flex-start;
    /* .tags-panel is absolutely positioned (out of flow) below — without
       this, card-wrap would be the row's only flex item and stretch to
       fill the whole width, rewrapping the bio and shifting everything
       whenever the tags panel's own position changes. */
    max-width: 568px;
  }

  .presentation-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
    text-align: left;
  }

  /* Plain again, no pill — parked here for now. */
  .kicker {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent-blue);
    margin: 0;
  }

  /* Plain again — light blue text, no pill. */
  .role__sep {
    color: var(--accent-blue);
    font-weight: 700;
  }

  /* Photo first, then the underlined name — the photo reads as the name's
     lead-in rather than a loose decoration. The line itself fades from the
     photo's own blue into Klein blue as it runs right, away from the photo. */
  .name-row {
    position: relative;
    display: flex;
    align-items: flex-end;
    gap: 0.85rem;
    padding-bottom: 0.1em;
  }

  .name-row::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 5px;
    background: linear-gradient(to right, var(--photo-blue), var(--accent-klein));
  }

  .name-avatar {
    flex: 0 0 auto;
    width: clamp(84px, 10vw, 128px);
    /* Was -0.15em, pulling the photo down INTO the bar's own 5px band —
       the photo's blue then covered the bar's actual gradient color
       across its whole width, so the two blues met with a visible seam
       right where the photo ends and the bar's real color reappears.
       Positive instead: photo stops above the bar, which stays visible
       and one consistent color the full row width. */
    margin-bottom: 0.2em;
  }

  .name-avatar img {
    display: block;
    width: 100%;
    height: auto;
    /* Square on BOTH bottom corners — the bar runs the full width right
       underneath, so either corner being rounded clips a quarter-circle
       of real (fully opaque) shoulder content, opening a visible notch
       against the bar regardless of what's actually drawn there. This
       was the real cause of the "gap under the sleeve" — not a
       transparent pixel in the source photo, a geometric corner clip. */
    border-radius: 8px 8px 0 0;
  }

  .bio {
    max-width: 34ch;
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--fg-muted);
    /* Lined up with "David" rather than flush with the photo/kicker — the
       photo eats the first ~134px of that row, so text starting flush
       left under it reads as unaligned with everything above it. */
    margin: 1.4rem 0 0 134px;
  }

  /* ── Tags — stacked, centered rows tapering 2-3-3-3-2 (no sharp single-
     item point at top/bottom — a circle has a flat chord there, not a
     tip). Rows sit close together (a plain gap, not stretched to fill a
     forced box) so the cluster itself reads round, not elongated. ────── */
  /* Out of flow, like .learning-badges — a margin-top big enough to reach
     down near "PROJETS" was inflating .presentation-inner's own height,
     which shifted the whole centered block (bio included) up to
     compensate. Absolute positioning can't affect flow height at all. */
  .tags-panel {
    position: absolute;
    top: 304px;
    right: 60px;
    width: 340px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* The 5 rows tapering 2-3-3-3-2 that read as a circle — their own tight
     gap, independent of the badges↔circle spacing above. */
  .tags-circle {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.55rem;
  }

  .tech-tag {
    display: block;
    height: 24px;
    width: auto;
    transition: transform 0.2s var(--ease-apple), filter 0.2s var(--ease-apple);
  }

  .tech-tag:hover {
    transform: translateY(-3px);
    filter: drop-shadow(0 4px 8px color-mix(in srgb, var(--accent-blue) 60%, transparent));
  }

  .name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.8rem, 7.5vw, 5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin: 0;
  }

  /* 7.5vw is sized against the viewport, not the space actually left after
     the photo + gap eat into it — right after the mobile breakpoint,
     .presentation-card-wrap is still narrow (the tags panel takes a fixed
     chunk beside it) so 7.5vw overshoots and "David Breau" wraps to two
     lines, with the underline bar (pinned to the row's bottom) then only
     running under the second line instead of the whole name. Measured
     empirically (headless, binary-searched the largest non-wrapping size at
     each width) to get a formula that stays under that wrap threshold with
     margin across 701-900px, and hands off at 900px to the normal 7.5vw
     rule at the point where 7.5vw is already safe on its own — so there's
     no visible jump at the handoff either. */
  @media (min-width: 701px) and (max-width: 900px) {
    .name {
      font-size: clamp(1.875rem, calc(-102px + 18.85vw), 5rem);
    }
  }

  .role {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--fg);
    margin: 0.6rem 0 0;
    display: block;
  }

  /* Empilés, pas en rangée — un futur 3e badge n'est qu'une ligne de plus,
     la largeur ne bouge pas. Ancré en absolu au coin haut-droit de
     .presentation-inner (pas dans le flux de .tags-panel) — la seule
     façon d'obtenir une position fixe en pixels depuis le bord droit,
     indépendante de la largeur de la colonne des tags. */
  .learning-badges {
    position: absolute;
    top: -97px;
    right: 8px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
  }

  .codewars-badge,
  .duolingo-badge {
    display: flex;
    align-items: center;
    text-decoration: none;
    opacity: 0.9;
    transition: opacity 0.2s var(--ease-apple);
  }
  .codewars-badge:hover,
  .duolingo-badge:hover {
    opacity: 1;
  }

  /* Same hexagonal pill for both — Codewars' real logo (its own brand red,
     cropped to a circle at build time) sits next to Duolingo's owl the
     same way; only the rank/streak text takes the per-platform color. */
  .stat-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 20px;
    padding: 0 0.65rem 0 0.5rem;
    background: #303133;
    /* Parallelogram lean, not a pointed hex — matches Codewars' own badge
       shape (both edges slant the same direction) rather than mirroring
       Duolingo's pointed-both-ends pill. */
    clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%);
    font-size: 0.68rem;
  }
  .stat-pill img {
    display: block;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    flex: 0 0 auto;
  }
  .stat-rank {
    font-weight: 700;
  }
  .stat-sep {
    color: #6a6a6c;
  }
  .stat-score {
    color: #b9b9ba;
    font-variant-numeric: tabular-nums;
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 2rem;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--fg-muted);
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: color 0.2s var(--ease-apple);
  }
  .scroll-cue:hover {
    color: var(--fg);
  }
  .scroll-cue svg {
    animation: bob 1.1s ease-in-out infinite;
  }

  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(7px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-cue svg { animation: none; }
    .level-track { scroll-behavior: auto; }
  }

  /* ── Scroll reveal — elements fly out to their outer side when a level
     leaves view, hinged rather than sliding off — it rotates away in depth
     while drifting slightly toward center, so as it returns it turns back
     to face the viewer instead of just sliding in from the side. ────── */
  [data-reveal] {
    transition: opacity 0.6s var(--ease-apple), transform 0.6s var(--ease-apple);
    transform-style: preserve-3d;
  }
  [data-reveal='left'] {
    opacity: 0;
    transform: translateX(30px) rotateY(-38deg);
  }
  [data-reveal='right'] {
    opacity: 0;
    transform: translateX(-30px) rotateY(38deg);
  }
  [data-reveal].is-in {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      transition: none;
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 700px) {
    /* Content routinely runs taller than 100dvh on short phones — flex
       centering then overflows equally both ways, pushing the photo up
       under the fixed social-dock and the tags panel down under the
       scroll-cue. Top-anchor instead, clear the dock explicitly, and let
       this level scroll internally as a safety net rather than clip. */
    .level-presentation {
      justify-content: flex-start;
      padding: 4.5rem 1.5rem 1.5rem;
      overflow-y: auto;
    }
    .presentation-inner {
      flex-direction: column;
      align-items: center;
      /* Desktop-only nudge (balances whitespace against the fixed social
         dock there) — this level already clears the dock itself via its
         own top padding, so the extra negative margin here would just
         push content back up under it. */
      margin-top: 0;
    }
    .presentation-card-wrap {
      width: 100%;
      max-width: 420px;
    }
    .presentation-card {
      align-items: center;
      text-align: center;
    }
    /* Keep the desktop's side-by-side photo+name (bar running under both,
       photo-blue fading into it) instead of stacking — stacking always put
       daylight between the photo and the bar, since the bar stays pinned
       under just the text. Same row, just sized down: a smaller fixed
       avatar so there's room for the name to stay on one line down to the
       narrowest phones (checked to 320px). */
    .name-row {
      align-items: center;
    }
    .name-avatar {
      width: 64px;
      margin-bottom: 0;
    }
    .name {
      font-size: 2.1rem;
    }
    .role {
      width: auto !important;
      margin-left: 0 !important;
      text-align: center;
      text-align-last: center;
    }
    .bio {
      max-width: 40ch;
      margin-left: 0;
      text-align: center;
    }
    /* Flatten the desktop's circular 2-3-3-3-2 row grouping into one
       free-flowing wrap — that grouping exists to read as a circle next
       to the photo, which doesn't apply once everything is stacked. */
    .tags-panel {
      position: static;
      width: 100%;
      max-width: 420px;
      margin-top: 1.5rem;
      /* Clears the absolutely-positioned .scroll-cue pinned to the bottom
         of this level, so the last badge row doesn't sit under it. */
      margin-bottom: 3.5rem;
      flex: 0 0 auto;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      /* .tags-circle and .tags-row both flatten to display:contents below,
         so every tag image becomes a direct flex child of .tags-panel
         itself here — this gap is what actually spaces them, not the
         desktop rule's 1.75rem (that gap is for keeping the badges group
         apart from the circle, meaningless once everything's one flat
         wrapped row). */
      gap: 0.55rem;
    }
    /* Both wrapper levels flatten out so the tag images become direct
       flex items of .tags-panel's row+wrap, same trick two levels deep. */
    .tags-circle {
      display: contents;
    }
    .tags-row {
      display: contents;
    }
    /* tags-panel goes row+wrap here for the tag pills — force the badge
       stack onto its own line first instead of inlining with them. Back to
       static/centered too: the desktop rule's absolute top-right pin only
       makes sense next to the tag circle, not stacked above everything. */
    .learning-badges {
      position: static;
      align-items: center;
      flex-basis: 100%;
      margin-bottom: 0.85rem;
    }
  }

  /* ── Niveau 2 : projets (styles inchangés, juste imbriqués) ─────────── */
  .page {
    max-width: 1250px;
    height: 100%;
    margin: 0 auto;
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .projects {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 0;
  }

  .stage {
    position: relative;
    display: flex;
    align-items: stretch;
    gap: 1.25rem;
    width: 100%;
    max-width: 1100px;
    aspect-ratio: 2.2 / 1;
    margin: 0 auto;
    flex-shrink: 0;
    /* .roulette-marker bleeds 0.5rem past .roulette's own left edge (its
       rounded cap). Setting overflow-y below forces overflow-x to 'auto'
       too (a paired-axis rule neither browser lets you opt out of), and
       auto clips exactly like hidden until something scrolls it — so
       without this padding the marker's left cap gets silently cut off. */
    padding-left: 0.5rem;
    /* Without this, a short roulette list can end up taller than its own
       aspect-ratio box (see the centering-padding note in the script below),
       and since a flex item's automatic min-height ignores aspect-ratio
       when overflow is visible, that inflated content silently grows
       .stage itself — leaving the roulette-marker's fixed top:50% pointing
       at the wrong item. overflow-y:hidden makes aspect-ratio authoritative
       again; overflow-x stays auto (nothing ever overflows horizontally). */
    overflow-y: hidden;
  }

  /* ── Roulette — vertical picker; the item nearest the marker is selected,
     matching the "toujours celui du milieu" behaviour asked for. ──────── */
  .roulette {
    position: relative;
    flex: 0 0 clamp(120px, 14vw, 170px);
  }

  /* The scroll container is a plain block, separate from the marker below —
     mixing position:sticky with scroll-snap on the same element is what
     was hanging Chromium's layout, so the two are kept apart. */
  .roulette-scroll {
    height: 100%;
    overflow-y: auto;
    scroll-snap-type: y mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .roulette-scroll::-webkit-scrollbar {
    display: none;
  }

  .roulette-marker {
    position: absolute;
    top: 50%;
    left: -0.5rem;
    right: -0.5rem;
    height: 2.3rem;
    transform: translateY(-50%);
    border-radius: 8px;
    border-left: 2px solid var(--marker-accent, var(--accent-gold));
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--marker-accent, var(--accent-gold)) 12%, transparent),
      transparent 70%
    );
    box-shadow: 0 0 14px -4px color-mix(in srgb, var(--marker-accent, var(--accent-gold)) 65%, transparent);
    transition: border-color 0.25s var(--ease-apple), box-shadow 0.25s var(--ease-apple);
    z-index: 0;
    pointer-events: none;
  }

  .roulette-track {
    display: flex;
    flex-direction: column;
    /* Vertical padding-percentage is resolved against the container's
       WIDTH per spec, not its height — useless here, so the real centering
       padding is computed in JS from the measured pixel height instead. */
  }

  .roulette-item {
    scroll-snap-align: center;
    flex: 0 0 2.3rem;
    display: flex;
    align-items: center;
    padding: 0 0.5rem 0 1.1rem;
    background: none;
    border: none;
    cursor: pointer;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    text-align: left;
    color: var(--fg-muted);
    opacity: 0.5;
    transform: scale(0.94);
    transform-origin: left center;
    transition: color 0.25s var(--ease-apple), opacity 0.25s var(--ease-apple), transform 0.25s var(--ease-apple);
  }

  .roulette-item[aria-selected='true'] {
    color: var(--fg);
    font-weight: 700;
    opacity: 1;
    transform: scale(1);
  }

  @media (max-width: 700px) {
    .stage {
      flex-direction: column;
      aspect-ratio: auto;
      height: auto;
      max-width: none;
      /* Desktop-only fix (roulette-marker doesn't exist here) — stacked
         content should stay centered, not nudged right. */
      padding-left: 0;
    }

    /* The desktop picker (fixed marker, list scrolls past it) reads as a
       gimmick on a touch screen — swiping a list past a stationary frame
       isn't a pattern people expect to tap. A tab row read too unfamiliar
       in turn — a compact vertical stack, same idea as desktop's list
       (bold + full opacity = selected, inherited from the base rule below)
       just without the scroll-driven marker, reads the most natural. */
    .roulette {
      order: 2;
      flex: 0 0 auto;
    }
    .roulette-scroll {
      height: auto;
      overflow: visible;
      scroll-snap-type: none;
    }
    .roulette-marker {
      display: none;
    }
    .roulette-track {
      flex-direction: column;
      align-items: center;
      gap: 0.35rem;
      padding: 0;
    }
    .roulette-item {
      flex: 0 0 auto;
      height: auto;
      padding: 0.3rem 0.85rem;
      text-align: center;
      border-radius: 8px;
      border-left: 2px solid transparent;
      scroll-snap-align: none;
    }
    /* Exactly the desktop marker pill's own rule set (border-left, gradient
       fill, glow) — not a uniform 4-side border, which reads as a different,
       flatter shape. Thick edge on the left only, soft fade on the rest. */
    .roulette-item[aria-selected='true'] {
      border-left-color: var(--marker-accent, var(--accent-gold));
      background: linear-gradient(
        to right,
        color-mix(in srgb, var(--marker-accent, var(--accent-gold)) 12%, transparent),
        transparent 70%
      );
      box-shadow: 0 0 14px -4px color-mix(in srgb, var(--marker-accent, var(--accent-gold)) 65%, transparent);
    }

    .detail-stage {
      position: relative;
      flex: 1;
      order: 1;
      min-height: 360px;
    }

    /* ProjectCard's mobile layout now stacks image above text in normal
       flow instead of absolutely overlapping them, so .detail-slot needs
       to grow with that content rather than being clipped to a fixed box. */
    .detail-slot {
      position: static;
    }
  }

  .detail-stage {
    position: relative;
    flex: 1;
    min-width: 0;
  }

  .detail-slot {
    display: none;
    position: absolute;
    inset: 0;
  }

  .detail-slot.is-active {
    display: block;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // ── Project selector (niveau 2) — click a name, its panel shows. The
    // list also scrolls the clicked item to center for visual polish, but
    // that scroll is cosmetic only — selection itself is direct, not
    // inferred from scroll position (a short list that already fits on
    // screen never scrolls, which used to mean the panel never updated). ──
    const cells = Array.from(document.querySelectorAll('.roulette-item')) as HTMLButtonElement[];
    const slots = Array.from(document.querySelectorAll('.detail-slot')) as HTMLElement[];
    const rouletteTrack = document.querySelector('.roulette-scroll') as HTMLElement | null;
    const rouletteTrackInner = document.querySelector('.roulette-track') as HTMLElement | null;
    const roulette = document.querySelector('.roulette') as HTMLElement | null;

    if (slots.length > 0) {
      // Vertical padding-percentage resolves against the container's WIDTH
      // per the CSS spec, not its height, so it can't center a short list
      // in a tall box — computed in real pixels here instead, on desktop
      // only (mobile's horizontal layout already centers fine via CSS %).
      if (rouletteTrack && rouletteTrackInner && cells[0] && !window.matchMedia('(max-width: 700px)').matches) {
        const pad = Math.max(0, rouletteTrack.clientHeight / 2 - cells[0].clientHeight / 2);
        rouletteTrackInner.style.paddingTop = `${pad}px`;
        rouletteTrackInner.style.paddingBottom = `${pad}px`;
      }

      const select = (index: number) => {
        cells.forEach((cell) => {
          const isSelected = Number(cell.dataset.index) === index;
          cell.setAttribute('aria-selected', String(isSelected));
          if (isSelected && roulette && cell.dataset.accent) {
            roulette.style.setProperty('--marker-accent', cell.dataset.accent);
          }
        });
        slots.forEach((slot) => {
          slot.classList.toggle('is-active', Number(slot.dataset.index) === index);
        });
      };

      cells.forEach((cell) => {
        cell.addEventListener('click', () => {
          select(Number(cell.dataset.index));
          // Scroll only the roulette itself (not scrollIntoView, which can
          // bubble to ancestor scroll containers like the level track).
          if (!rouletteTrack) return;
          rouletteTrack.scrollTo({
            top: cell.offsetTop - rouletteTrack.clientHeight / 2 + cell.clientHeight / 2,
            behavior: 'smooth',
          });
        });
      });

      // Scrolling/dragging the list also changes the selection — whichever
      // item is closest to the marker once scrolling settles wins. Simple
      // "closest wins" on scroll-end, not a live threshold watch, so it
      // can't silently stop firing the way the old IntersectionObserver did.
      if (rouletteTrack) {
        let scrollSettleTimer: ReturnType<typeof setTimeout>;
        rouletteTrack.addEventListener('scroll', () => {
          clearTimeout(scrollSettleTimer);
          scrollSettleTimer = setTimeout(() => {
            const isMobile = window.matchMedia('(max-width: 700px)').matches;
            const trackCenter = isMobile
              ? rouletteTrack.scrollLeft + rouletteTrack.clientWidth / 2
              : rouletteTrack.scrollTop + rouletteTrack.clientHeight / 2;
            let closest = cells[0];
            let closestDist = Infinity;
            cells.forEach((cell) => {
              const cellCenter = isMobile
                ? cell.offsetLeft + cell.clientWidth / 2
                : cell.offsetTop + cell.clientHeight / 2;
              const dist = Math.abs(cellCenter - trackCenter);
              if (dist < closestDist) {
                closestDist = dist;
                closest = cell;
              }
            });
            select(Number(closest.dataset.index));
          }, 120);
        });
      }

      select(0);
      // Center the first item within the roulette itself only — scrollIntoView()
      // can bubble to ancestor scroll containers (the level track) and fight
      // its own scroll-snap on load, so scrollTop is set directly instead.
      if (rouletteTrack && cells[0]) {
        requestAnimationFrame(() => {
          const target = cells[0];
          rouletteTrack.scrollTop =
            target.offsetTop - rouletteTrack.clientHeight / 2 + target.clientHeight / 2;
        });
      }
    }

    // ── Line up the role text under "David Breau" only — not the photo
    // beside it. Just a left offset now: text-align-last:justify used to
    // also force the role's box to the name's exact width, stretching
    // "Data analyst / Data ingénieur" (much shorter than "David Breau" at
    // this font size) into huge gaps between words to fill it. ──────────
    const nameLine = document.getElementById('name-line');
    const roleLine = document.getElementById('role-line');
    const roleCard = document.querySelector('.presentation-card') as HTMLElement | null;
    if (nameLine && roleLine && roleCard) {
      const matchOffset = () => {
        const nameRect = nameLine.getBoundingClientRect();
        const cardRect = roleCard.getBoundingClientRect();
        roleLine.style.marginLeft = `${nameRect.left - cardRect.left}px`;
      };
      matchOffset();
      window.addEventListener('resize', matchOffset);
    }

    fetch('/api/duolingo')
      .then((res) => (res.ok ? res.json() : Promise.reject()))
      .then((data: { users?: { streak?: number; totalXp?: number }[] }) => {
        const user = data.users?.[0];
        const streakEl = document.querySelector('[data-duolingo-streak]');
        const xpEl = document.querySelector('[data-duolingo-xp]');
        if (streakEl && typeof user?.streak === 'number') {
          streakEl.textContent = String(user.streak);
        }
        if (xpEl && typeof user?.totalXp === 'number') {
          xpEl.textContent = user.totalXp.toLocaleString('en-US');
        }
      })
      .catch(() => {
        // relais nginx pas encore en place / indisponible : on garde les valeurs statiques
      });

    // ── Level track: scroll-cue button + level indicator dots ───────────
    const track = document.getElementById('level-track');
    const levels = Array.from(document.querySelectorAll('.level')) as HTMLElement[];
    const dots = Array.from(document.querySelectorAll('.level-dot')) as HTMLElement[];
    const scrollCue = document.querySelector('.scroll-cue') as HTMLButtonElement | null;

    scrollCue?.addEventListener('click', () => {
      const target = levels[Number(scrollCue.dataset.goto)];
      target?.scrollIntoView({ behavior: 'smooth' });
    });

    if (track && levels.length > 0) {
      const observer = new IntersectionObserver(
        (obsEntries) => {
          obsEntries.forEach((obsEntry) => {
            if (obsEntry.isIntersecting) {
              const idx = levels.indexOf(obsEntry.target as HTMLElement);
              dots.forEach((dot, i) => dot.classList.toggle('is-active', i === idx));
            }
          });
        },
        { root: track, threshold: 0.6 }
      );
      levels.forEach((level) => observer.observe(level));
    }

    // ── Reveal: slide elements in as they enter view, re-trigger both ways ──
    if (track) {
      const revealEls = Array.from(document.querySelectorAll('[data-reveal]'));
      const revealObserver = new IntersectionObserver(
        (obsEntries) => {
          obsEntries.forEach((obsEntry) => {
            obsEntry.target.classList.toggle('is-in', obsEntry.isIntersecting);
          });
        },
        { root: track, threshold: 0.35 }
      );
      revealEls.forEach((el) => revealObserver.observe(el));
    }
  });
</script>
