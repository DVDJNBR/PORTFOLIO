---
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const entries = await getCollection('projects');
entries.sort((a, b) => b.data.order - a.data.order);

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '../content/projects/*/assets/*.{png,jpg,jpeg,webp,avif}'
);

interface ProjectAssets {
  icon: string | null;
  backdrop: string | null;
  depth: string | null;
}

function splitAssets(named: { name: string; url: string }[]): ProjectAssets {
  let icon: string | null = null;
  let backdrop: string | null = null;
  let depth: string | null = null;

  for (const { name, url } of named) {
    const base = name.replace(/\.[^.]+$/, '').toLowerCase();
    if (base === 'icon-selection') {
      icon = url;
    } else if (base === 'transparent-selection') {
      backdrop = url;
    } else if (base === 'depth-selection') {
      depth = url;
    }
  }

  return { icon, backdrop, depth };
}

async function fetchGithubAssets(repo: string): Promise<ProjectAssets> {
  try {
    const res = await fetch(`https://api.github.com/repos/${repo}/contents/assets`, {
      headers: { Accept: 'application/vnd.github+json', 'User-Agent': 'portfolio-build' },
    });
    if (!res.ok) return { icon: null, backdrop: null, depth: null };

    const files: { name: string; type: string; download_url: string }[] = await res.json();
    const named = files
      .filter((f) => f.type === 'file' && /\.(png|jpe?g|webp|avif|gif)$/i.test(f.name))
      .map((f) => ({ name: f.name, url: f.download_url }));

    return splitAssets(named);
  } catch {
    return { icon: null, backdrop: null, depth: null };
  }
}

const projectAssets: Record<string, ProjectAssets> = {};
for (const entry of entries) {
  if (entry.data.githubRepo) {
    projectAssets[entry.id] = await fetchGithubAssets(entry.data.githubRepo);
    continue;
  }

  const folder = entry.id.split('/')[0];
  const matches = Object.entries(allImages).filter(([p]) => p.includes(`/projects/${folder}/assets/`));

  const named: { name: string; url: string }[] = [];
  for (const [path, load] of matches) {
    const mod = await load();
    named.push({ name: path.split('/').pop() ?? '', url: mod.default.src });
  }
  projectAssets[entry.id] = splitAssets(named);
}

const preloadImages = Object.values(projectAssets).flatMap((a) =>
  [a.backdrop, a.icon, a.depth].filter((url): url is string => Boolean(url))
);
---

<Layout preloadImages={preloadImages}>
  <div class="page">
    <header class="banner">
      <div class="banner-identity">
        <span class="brand-name">David Breau</span>
        <span class="brand-role">Portfolio · Data Engineer/Analyst</span>
      </div>
      <div class="banner-actions">
        <div class="social-links">
          <a href="https://www.linkedin.com/in/david-breau" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="https://x.com/d4v1dbr34u" target="_blank" rel="noopener noreferrer">Twitter</a>
        </div>
      </div>
    </header>

    <main class="main">
      <section class="projects">
        <div class="stage">
          <div class="detail-stage">
            {entries.map((entry, i) => (
              <div class="detail-slot" data-index={i}>
                <ProjectCard
                  title={entry.data.title}
                  description={entry.data.description}
                  url={entry.data.url}
                  tags={entry.data.tags}
                  backdrop={projectAssets[entry.id]?.backdrop}
                  depth={projectAssets[entry.id]?.depth}
                  accent={entry.data.accent}
                />
              </div>
            ))}
          </div>

          <div class="select-panel">
            <span class="select-label">Projets</span>
            <div class="select-grid" role="listbox" aria-label="Sélection de projet">
              {entries.map((entry, i) => (
                <button
                  type="button"
                  class="select-cell"
                  data-index={i}
                  role="option"
                  title={entry.data.title}
                  aria-label={entry.data.title}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  style={entry.data.accent ? `--cell-glow: ${entry.data.accent};` : undefined}
                >
                  <span class="select-thumb">
                    <span class="select-thumb-clip">
                      <span class="select-thumb-fill">
                        {(() => {
                          const icon = projectAssets[entry.id]?.icon;
                          return icon ? (
                            <img src={icon} alt="" />
                          ) : (
                            <span class="select-thumb-fallback">{entry.data.title.charAt(0)}</span>
                          );
                        })()}
                      </span>
                    </span>
                    <svg class="thumb-glow" viewBox="0 0 36 68" preserveAspectRatio="none" aria-hidden="true">
                      <polygon points="5.04,0 36,0 30.96,68 0,68" pathLength="100" class="thumb-glow-blur"></polygon>
                      <polygon points="5.04,0 36,0 30.96,68 0,68" pathLength="100" class="thumb-glow-line"></polygon>
                    </svg>
                  </span>
                </button>
              ))}
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>
</Layout>

<style>
  .page {
    max-width: 1250px;
    height: 100dvh;
    margin: 0 auto;
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .banner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: nowrap;
    gap: 0.75rem;
    margin: -1.25rem -1.5rem 1.25rem;
    padding: 1rem 1.5rem;
    background: color-mix(in srgb, var(--bg) 65%, transparent);
    backdrop-filter: saturate(160%) blur(20px);
    -webkit-backdrop-filter: saturate(160%) blur(20px);
    border-bottom: 1px solid var(--border);
  }

  .banner-identity {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.3rem;
    letter-spacing: -0.01em;
    color: var(--fg);
  }
  .brand-role {
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    color: var(--fg-muted);
  }

  .banner-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .brand-role {
      display: none;
    }
    .banner-actions {
      gap: 0.6rem;
    }
    .social-links {
      gap: 0.6rem;
    }
  }

  .social-links {
    display: flex;
    gap: 1rem;
  }
  .social-links a {
    color: var(--fg-muted);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.85rem;
    letter-spacing: -0.01em;
    transition: color 0.2s var(--ease-apple);
  }
  .social-links a:hover {
    color: var(--accent);
  }

  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .projects {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 0;
  }

  .stage {
    position: relative;
    width: 100%;
    max-width: 1040px;
    aspect-ratio: 2 / 1;
    margin: 0 auto;
    flex-shrink: 0;
  }

  .select-panel {
    position: absolute;
    left: calc(66.6667% - 40px);
    right: 20px;
    bottom: 55px;
    transform: translateY(50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .select-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-muted);
  }

  .select-grid {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0;
    height: 72px;
  }

  @media (max-width: 420px) {
    .stage {
      display: flex;
      flex-direction: column;
    }

    .select-panel {
      position: static;
      transform: none;
      width: auto;
      max-width: none;
      margin: 0.5rem auto 0;
      order: 2;
    }

    .detail-stage {
      flex: 1;
      order: 1;
    }
  }

  .select-cell {
    position: relative;
    display: flex;
    flex-shrink: 0;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font: inherit;
    color: inherit;
  }

  .select-thumb {
    position: relative;
    z-index: 0;
    width: 36px;
    height: 68px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.35s var(--ease-apple);
  }

  .select-thumb-clip {
    position: absolute;
    inset: 0;
    z-index: -1;
    clip-path: polygon(14% 0, 100% 0, 86% 100%, 0 100%);
    background: var(--border);
    box-shadow: var(--shadow-sm);
    transition: background-color 0.25s var(--ease-apple);
  }

  .select-cell.is-glowing .select-thumb-clip {
    background: var(--cell-glow, var(--accent-gold));
  }

  .select-thumb-fill {
    position: absolute;
    inset: 1px;
    overflow: hidden;
    background: var(--elevated);
    clip-path: polygon(14% 0, 100% 0, 86% 100%, 0 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .thumb-glow {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s var(--ease-apple);
  }

  .thumb-glow-blur,
  .thumb-glow-line {
    fill: none;
    stroke: color-mix(in srgb, var(--cell-glow, var(--accent-gold)) 55%, white);
    stroke-linecap: round;
    stroke-dasharray: 12 88;
    animation: thumb-glow-travel 26s linear infinite;
  }

  .thumb-glow-blur {
    stroke-width: 5;
    filter: blur(3px);
    opacity: 0.65;
  }

  .thumb-glow-line {
    stroke-width: 1.4;
  }

  @keyframes thumb-glow-travel {
    to {
      stroke-dashoffset: -100;
    }
  }

  .select-cell.is-glowing .thumb-glow {
    opacity: 1;
  }

  .select-thumb-fill img {
    width: 130%;
    height: 100%;
    object-fit: cover;
  }

  .select-thumb-fallback {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--fg-muted);
  }

  .select-cell[aria-selected='true'] {
    z-index: 1;
  }

  .detail-stage {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .detail-slot {
    display: none;
    position: absolute;
    inset: 0;
  }

  .detail-slot.is-active {
    display: block;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const cells = Array.from(document.querySelectorAll('.select-cell')) as HTMLButtonElement[];
    const slots = Array.from(document.querySelectorAll('.detail-slot')) as HTMLElement[];

    if (slots.length === 0) return;

    let confirmedIndex = 0;

    const showSlot = (index: number) => {
      slots.forEach((slot) => {
        slot.classList.toggle('is-active', Number(slot.dataset.index) === index);
      });
      cells.forEach((cell) => {
        cell.classList.toggle('is-glowing', Number(cell.dataset.index) === index);
      });
    };

    const applyWave = (focusIndex: number) => {
      cells.forEach((cell, i) => {
        const thumb = cell.querySelector('.select-thumb') as HTMLElement | null;
        if (!thumb) return;
        const dist = Math.min(Math.abs(i - focusIndex), 4);
        const lift = Math.max(0, 4 - dist) * 3;
        const scale = 1 - dist * 0.05;
        thumb.style.transform = `translateY(-${lift}px) scale(${Math.max(scale, 0.82)})`;
      });
    };

    const select = (index: number) => {
      confirmedIndex = index;
      cells.forEach((cell) => {
        cell.setAttribute('aria-selected', String(Number(cell.dataset.index) === index));
      });
      showSlot(index);
      applyWave(index);
    };

    cells.forEach((cell) => {
      cell.addEventListener('click', () => {
        select(Number(cell.dataset.index));
      });
      cell.addEventListener('mouseenter', () => {
        const i = Number(cell.dataset.index);
        showSlot(i);
        applyWave(i);
      });
    });

    const grid = document.querySelector('.select-grid');
    grid?.addEventListener('mouseleave', () => {
      showSlot(confirmedIndex);
      applyWave(confirmedIndex);
    });

    select(0);
  });
</script>
