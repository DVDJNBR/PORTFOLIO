---
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const entries = await getCollection('projects');
entries.sort((a, b) => b.data.order - a.data.order);

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '../content/projects/*/assets/*.{png,jpg,jpeg,webp,avif}'
);

interface ProjectAssets {
  icon: string | null;
  backdrop: string | null;
  depth: string | null;
}

function splitAssets(named: { name: string; url: string }[]): ProjectAssets {
  let icon: string | null = null;
  let backdrop: string | null = null;
  let depth: string | null = null;

  for (const { name, url } of named) {
    const base = name.replace(/\.[^.]+$/, '').toLowerCase();
    if (base === 'icon-selection') {
      icon = url;
    } else if (base === 'transparent-selection') {
      backdrop = url;
    } else if (base === 'depth-selection') {
      depth = url;
    }
  }

  return { icon, backdrop, depth };
}

async function fetchGithubAssets(repo: string): Promise<ProjectAssets> {
  try {
    const res = await fetch(`https://api.github.com/repos/${repo}/contents/assets`, {
      headers: { Accept: 'application/vnd.github+json', 'User-Agent': 'portfolio-build' },
    });
    if (!res.ok) return { icon: null, backdrop: null, depth: null };

    const files: { name: string; type: string; download_url: string }[] = await res.json();
    const named = files
      .filter((f) => f.type === 'file' && /\.(png|jpe?g|webp|avif|gif)$/i.test(f.name))
      .map((f) => ({ name: f.name, url: f.download_url }));

    return splitAssets(named);
  } catch {
    return { icon: null, backdrop: null, depth: null };
  }
}

const projectAssets: Record<string, ProjectAssets> = {};
for (const entry of entries) {
  if (entry.data.githubRepo) {
    projectAssets[entry.id] = await fetchGithubAssets(entry.data.githubRepo);
    continue;
  }

  const folder = entry.id.split('/')[0];
  const matches = Object.entries(allImages).filter(([p]) => p.includes(`/projects/${folder}/assets/`));

  const named: { name: string; url: string }[] = [];
  for (const [path, load] of matches) {
    const mod = await load();
    named.push({ name: path.split('/').pop() ?? '', url: mod.default.src });
  }
  projectAssets[entry.id] = splitAssets(named);
}

const preloadImages = Object.values(projectAssets).flatMap((a) =>
  [a.backdrop, a.icon, a.depth].filter((url): url is string => Boolean(url))
);
---

<Layout preloadImages={preloadImages}>
  <div class="page">
    <header class="banner">
      <div class="banner-identity">
        <span class="brand-name">David Breau</span>
        <span class="brand-role">Portfolio · Data Engineer/Analyst</span>
      </div>
      <div class="banner-actions">
        <div class="social-links">
          <a href="https://www.linkedin.com/in/david-breau" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="https://x.com/d4v1dbr34u" target="_blank" rel="noopener noreferrer">Twitter</a>
        </div>
        <ThemeToggle />
      </div>
    </header>

    <main class="main">
      <section class="projects">
        <h2 class="section-title">Projets</h2>

        <div class="stage">
          <div class="detail-stage">
            {entries.map((entry, i) => (
              <div class="detail-slot" data-index={i}>
                <ProjectCard
                  title={entry.data.title}
                  description={entry.data.description}
                  url={entry.data.url}
                  tags={entry.data.tags}
                  backdrop={projectAssets[entry.id]?.backdrop}
                  depth={projectAssets[entry.id]?.depth}
                />
              </div>
            ))}
          </div>

          <div class="select-grid" role="listbox" aria-label="Sélection de projet">
            {entries.map((entry, i) => (
              <button
                type="button"
                class="select-cell"
                data-index={i}
                role="option"
                title={entry.data.title}
                aria-label={entry.data.title}
                aria-selected={i === 0 ? 'true' : 'false'}
              >
                <span class="select-thumb">
                  {(() => {
                    const icon = projectAssets[entry.id]?.icon;
                    return icon ? (
                      <img src={icon} alt="" />
                    ) : (
                      <span class="select-thumb-fallback">{entry.data.title.charAt(0)}</span>
                    );
                  })()}
                </span>
              </button>
            ))}
          </div>
        </div>
      </section>
    </main>
  </div>
</Layout>

<style>
  .page {
    max-width: 1250px;
    height: 100dvh;
    margin: 0 auto;
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .banner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: nowrap;
    gap: 0.75rem;
    margin: -1.25rem -1.5rem 1.25rem;
    padding: 1rem 1.5rem;
    background:
      repeating-linear-gradient(
        115deg,
        rgba(255, 255, 255, 0.035) 0px,
        rgba(255, 255, 255, 0.035) 2px,
        transparent 2px,
        transparent 10px
      ),
      linear-gradient(100deg, #0a0a0c 0%, #1b1b20 55%, #0a0a0c 100%);
    border-bottom: 3px solid var(--accent);
    box-shadow: 0 6px 24px -8px rgba(0, 0, 0, 0.6);
  }

  .banner-identity {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.3rem;
    letter-spacing: 0.03em;
    color: #f5f5f5;
    text-shadow: 0 0 12px color-mix(in srgb, var(--accent) 60%, transparent);
  }
  .brand-role {
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: #a8a8ad;
  }

  .banner-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .brand-role {
      display: none;
    }
    .banner-actions {
      gap: 0.6rem;
    }
    .social-links {
      gap: 0.6rem;
    }
  }

  .social-links {
    display: flex;
    gap: 1rem;
  }
  .social-links a {
    color: #d8d8dc;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    transition: color 0.2s;
  }
  .social-links a:hover {
    color: var(--accent);
  }

  .banner-actions :global(#theme-toggle) {
    border-color: rgba(255, 255, 255, 0.25);
    color: #f5f5f5;
  }
  .banner-actions :global(#theme-toggle:hover) {
    background: rgba(255, 255, 255, 0.1);
  }

  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .projects {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 0;
  }

  .section-title {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-muted);
  }

  .stage {
    position: relative;
    width: 100%;
    max-width: 1040px;
    aspect-ratio: 2 / 1;
    margin: 0 auto;
    flex-shrink: 0;
  }

  .stage::before {
    content: '';
    position: absolute;
    inset: -10%;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse 55% 60% at 30% 45%,
        color-mix(in srgb, var(--accent) 45%, #fff 20%),
        color-mix(in srgb, var(--accent) 30%, transparent) 45%,
        transparent 70%
      ),
      radial-gradient(
        ellipse 40% 45% at 78% 65%,
        color-mix(in srgb, var(--accent-2) 35%, transparent),
        transparent 65%
      );
    opacity: 0.5;
  }

  .select-grid {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0;
    height: 72px;
    position: absolute;
    left: calc(66.6667% - 40px);
    right: 20px;
    bottom: 30px;
    transform: translateY(50%);
    z-index: 2;
  }

  @media (max-width: 420px) {
    .stage {
      display: flex;
      flex-direction: column;
    }

    .select-grid {
      position: static;
      transform: none;
      width: auto;
      max-width: none;
      margin: 0.5rem auto 0;
      order: 2;
    }

    .detail-stage {
      flex: 1;
      order: 1;
    }
  }

  .select-cell {
    position: relative;
    display: flex;
    flex-shrink: 0;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font: inherit;
    color: inherit;
  }

  .select-thumb {
    width: 36px;
    height: 68px;
    padding: 0;
    border-radius: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    background: linear-gradient(160deg, color-mix(in srgb, var(--accent) 16%, var(--surface)), var(--surface));
    display: flex;
    align-items: center;
    justify-content: center;
    transform: skewX(-8deg);
    transition: background 0.2s, border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }

  .select-thumb img {
    width: 130%;
    height: 100%;
    object-fit: cover;
    transform: skewX(8deg);
  }

  .select-thumb-fallback {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--fg-muted);
  }

  .select-cell:hover .select-thumb {
    border-color: var(--accent);
    background: linear-gradient(160deg, color-mix(in srgb, var(--accent) 30%, var(--surface)), var(--surface));
    transform: skewX(-8deg) translateY(-3px);
  }

  .select-cell[aria-selected='true'] {
    z-index: 1;
  }
  .select-cell[aria-selected='true'] .select-thumb {
    border-color: #fde047;
    background: linear-gradient(160deg, color-mix(in srgb, var(--accent) 45%, var(--surface)), var(--surface));
    box-shadow: 0 0 0 3px color-mix(in srgb, #fde047 45%, transparent);
    transform: skewX(-8deg) scale(1.08);
  }

  .detail-stage {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .detail-slot {
    display: none;
    position: absolute;
    inset: 0;
  }

  .detail-slot.is-active {
    display: block;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const cells = Array.from(document.querySelectorAll('.select-cell')) as HTMLButtonElement[];
    const slots = Array.from(document.querySelectorAll('.detail-slot')) as HTMLElement[];

    if (slots.length === 0) return;

    let confirmedIndex = 0;

    const showSlot = (index: number) => {
      slots.forEach((slot) => {
        slot.classList.toggle('is-active', Number(slot.dataset.index) === index);
      });
    };

    const select = (index: number) => {
      confirmedIndex = index;
      cells.forEach((cell) => {
        cell.setAttribute('aria-selected', String(Number(cell.dataset.index) === index));
      });
      showSlot(index);
    };

    cells.forEach((cell) => {
      cell.addEventListener('click', () => {
        select(Number(cell.dataset.index));
      });
      cell.addEventListener('mouseenter', () => {
        showSlot(Number(cell.dataset.index));
      });
      cell.addEventListener('mouseleave', () => {
        showSlot(confirmedIndex);
      });
    });

    select(0);
  });
</script>
