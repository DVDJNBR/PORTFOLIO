---
import fs from 'node:fs';
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { TAG_BADGES, tagBadge } from '../data/tags';

const hasWattWatcherVideo = fs.existsSync('public/video/watt-watcher.mp4');

const entries = await getCollection('projects');
entries.sort((a, b) => b.data.order - a.data.order);

const TAG_PRIORITY = [
  'Python',
  'Databricks',
  'Delta Lake',
  'Snowflake',
  'dbt',
  'Azure',
  'Terraform',
  'Docker',
  'FastAPI',
  'Streamlit',
  'React',
  'Supabase',
  'Azure Functions',
];

// Auto-populated from projects, sorted by data engineering pipeline priority
const allTags = [...new Set(entries.flatMap((e) => e.data.tags))].sort((a, b) => {
  const ia = TAG_PRIORITY.indexOf(a);
  const ib = TAG_PRIORITY.indexOf(b);
  if (ia !== -1 && ib !== -1) return ia - ib;
  if (ia !== -1) return -1;
  if (ib !== -1) return 1;
  return a.localeCompare(b);
});

// Map each tag to matching projects for interactive filtering
const tagToProjects: Record<string, { index: number; title: string; accent: string }[]> = {};
entries.forEach((entry, index) => {
  for (const tag of entry.data.tags) {
    if (!tagToProjects[tag]) tagToProjects[tag] = [];
    tagToProjects[tag].push({
      index,
      title: entry.data.title,
      accent: entry.data.accent ?? '#6fa3d8',
    });
  }
});

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '../content/projects/*/assets/*.{png,jpg,jpeg,webp,avif}'
);

interface ProjectAssets {
  icon: string | null;
  backdrop: string | null;
  depth: string | null;
}

function splitAssets(named: { name: string; url: string }[]): ProjectAssets {
  let icon: string | null = null;
  let backdrop: string | null = null;
  let depth: string | null = null;

  for (const { name, url } of named) {
    const base = name.replace(/\.[^.]+$/, '').toLowerCase();
    if (base === 'icon-selection') {
      icon = url;
    } else if (base === 'transparent-selection') {
      backdrop = url;
    } else if (base === 'depth-selection') {
      depth = url;
    }
  }

  return { icon, backdrop, depth };
}

const projectAssets: Record<string, ProjectAssets> = {};
for (const entry of entries) {
  const folder = entry.id.split('/')[0];
  const matches = Object.entries(allImages).filter(([p]) => p.includes(`/projects/${folder}/assets/`));

  const named: { name: string; url: string }[] = [];
  for (const [path, load] of matches) {
    const mod = await load();
    named.push({ name: path.split('/').pop() ?? '', url: mod.default.src });
  }
  projectAssets[entry.id] = splitAssets(named);
}

const preloadImages = Object.values(projectAssets).flatMap((a) =>
  [a.backdrop, a.icon, a.depth].filter((url): url is string => Boolean(url))
);

// Codewars has a real public JSON API (unlike Duolingo, which needed the
// client-side fetch + static-value fallback below) — fetched once here at
// build time, no relay or client JS needed for it to stay accurate.
const CODEWARS_RANK_COLORS: Record<string, string> = {
  white: 'var(--kyu-white)',
  yellow: 'var(--kyu-yellow)',
  blue: 'var(--kyu-blue)',
  purple: 'var(--kyu-purple)',
  red: 'var(--kyu-red)',
  black: 'var(--kyu-black)',
};

let codewars = { rank: '4 kyu', honor: 1257, color: CODEWARS_RANK_COLORS.blue };
try {
  const res = await fetch('https://www.codewars.com/api/v1/users/DVDJNBR');
  if (res.ok) {
    const data = await res.json();
    codewars = {
      rank: data.ranks.overall.name,
      honor: data.honor,
      color: CODEWARS_RANK_COLORS[data.ranks.overall.color] ?? 'var(--fg)',
    };
  }
} catch {
  // Codewars unreachable at build time — keep the last known values above.
}
---

<Layout preloadImages={preloadImages}>
  <div class="site">
    <!-- Persistent social dock — Neumorphic / Soft UI block -->
    <nav class="social-dock" aria-label="Réseaux">
      <a href="https://www.linkedin.com/in/david-breau" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.84-3.03-1.85 0-2.14 1.44-2.14 2.94v5.66H9.37V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/>
        </svg>
      </a>
      <a href="https://github.com/DVDJNBR" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.58 2 12.19c0 4.49 2.87 8.3 6.84 9.64.5.1.68-.22.68-.49 0-.24-.01-.88-.01-1.72-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.89 1.57 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.73 0 0 .84-.28 2.75 1.05a9.29 9.29 0 0 1 5 0c1.9-1.33 2.74-1.05 2.74-1.05.55 1.42.2 2.47.1 2.73.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.79-4.57 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.48-.01 2.81 0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.19C22 6.58 17.52 2 12 2z"/>
        </svg>
      </a>
      <a href="https://x.com/d4v1dbr34u/all" target="_blank" rel="noopener noreferrer" aria-label="Twitter / X">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M18.24 3H21l-6.5 7.43L22.2 21h-6.32l-4.95-6.47L5.2 21H2.44l6.96-7.95L2 3h6.48l4.48 5.92L18.24 3zm-1.1 16.17h1.76L7.94 4.73H6.05l11.09 14.44z"/>
        </svg>
      </a>
    </nav>

    <main class="page-content">
      <!-- ── Section 1 : Présentation (Étalée horizontalement, compacte) ── -->
      <section class="section-presentation">
        <div class="presentation-header-row">
          <div class="profile-group">
            <div class="name-avatar">
              <img src="/img/profile.png?v=6" alt="David Breau" />
            </div>
            <div class="name-titles">
              <span class="kicker">Portfolio</span>
              <h1 class="name">David Breau</h1>
              <p class="role">Data analyst <span class="role__sep">/</span> Data ingénieur</p>
            </div>
          </div>

          <!-- Code Wars + Duolingo en haut à droite -->
          <div class="learning-badges">
            <a
              href="https://www.codewars.com/users/DVDJNBR"
              target="_blank"
              rel="noopener noreferrer"
              class="codewars-badge"
              aria-label={`Codewars — ${codewars.rank}, ${codewars.honor.toLocaleString('en-US')} xp`}
            >
              <span class="stat-pill">
                <img src="/img/codewars-icon.png" alt="" width="18" height="18" />
                <span class="stat-rank">{codewars.rank}</span>
                <span class="stat-sep">·</span>
                <span class="stat-score">{codewars.honor.toLocaleString('en-US')} xp</span>
              </span>
            </a>
            <a
              href="https://www.duolingo.com/profile/d4v1dbr34u"
              target="_blank"
              rel="noopener noreferrer"
              class="duolingo-badge"
              aria-label="Duolingo"
            >
              <span class="stat-pill">
                <img src="/img/duolingo-icon.png" alt="" width="18" height="18" />
                <span class="stat-rank" data-duolingo-streak>–</span>
                <span class="stat-sep">·</span>
                <span class="stat-score"><span data-duolingo-xp>–</span> xp</span>
              </span>
            </a>
          </div>
        </div>

        <p class="bio">
          Double cursus data analyst / data ingénieur : je conçois et je construis, de
          l'ingestion à la donnée exploitable. Pipelines, architectures cloud, modélisation,
          jusqu'à la visualisation. Des dashboards interactifs pour comprendre un phénomène ou
          aider à la décision.
        </p>

      </section>

      <!-- ── Section 2 : Projets (Projet phare affiché d'emblée) ── -->
      <section class="section-projects">
        <!-- En-tête de section Projets : sobre, épuré et technique -->
        <div class="projects-section-header">
          <div class="section-title-group">
            <span class="section-kicker">PROJETS SÉLECTIONNÉS</span>
            <span class="section-count-badge" id="projects-count">{entries.length} PROJETS</span>
          </div>

          <div class="active-filter-indicator" id="active-filter-indicator" hidden>
            <span class="active-filter-text">Filtre :</span>
            <span class="active-filter-badge-box">
              <img id="active-filter-badge-img" src="" alt="" class="active-filter-img" />
            </span>
            <button type="button" id="active-filter-reset" class="filter-clear-btn" title="Réinitialiser le filtre">
              ✕ Voir tout
            </button>
          </div>
        </div>

        <div class="stage">
          <div class="roulette" role="listbox" aria-label="Sélection de projet">
            <div class="roulette-scroll">
              <div class="roulette-track">
                {entries.map((entry, i) => (
                  <button
                    type="button"
                    class="roulette-item"
                    data-index={i}
                    data-accent={entry.data.accent}
                    data-tags={JSON.stringify(entry.data.tags)}
                    role="option"
                    aria-selected={i === 0 ? 'true' : 'false'}
                  >
                    {entry.data.title}
                  </button>
                ))}
              </div>
            </div>
            <span class="roulette-marker" aria-hidden="true"></span>
          </div>

          <div class="detail-stage">
            {entries.map((entry, i) => (
              <div class="detail-slot" data-index={i}>
                <ProjectCard
                  title={entry.data.title}
                  description={entry.data.description}
                  url={entry.data.url}
                  tags={entry.data.tags}
                  backdrop={projectAssets[entry.id]?.backdrop}
                  depth={projectAssets[entry.id]?.depth}
                  accent={entry.data.accent}
                  denseVisual={entry.id.startsWith('nyc-taxi') || entry.id.startsWith('watt-watcher')}
                >
                  <Fragment slot="visual">
                    {entry.id.startsWith('nyc-taxi') ? (
                      <img src="/img/nyc-taxi-chart.png" alt="Courses de taxi par heure à New York" class="silhouette" />
                    ) : entry.id.startsWith('watt-watcher') ? (
                      hasWattWatcherVideo ? (
                        <video
                          src="/video/watt-watcher.mp4"
                          poster="/img/watt-watcher-poster.png"
                          class="silhouette"
                          autoplay
                          loop
                          muted
                          playsinline
                          preload="none"
                        >
                          <img src="/img/watt-watcher-poster.png" alt="Carte temps réel des centrales et météo — Watt Watcher" class="silhouette" />
                        </video>
                      ) : (
                        <img src="/img/watt-watcher-poster.png" alt="Carte temps réel des centrales et météo — Watt Watcher" class="silhouette" />
                      )
                    ) : (
                      <>
                        {projectAssets[entry.id]?.depth && (
                          <img src={projectAssets[entry.id].depth} alt="" class="silhouette-depth" />
                        )}
                        {projectAssets[entry.id]?.backdrop && (
                          <img src={projectAssets[entry.id].backdrop} alt="" class="silhouette" />
                        )}
                      </>
                    )}
                  </Fragment>
                </ProjectCard>
              </div>
            ))}
          </div>
        </div>
      </section>
    </main>
  </div>
</Layout>

<style>
  .site {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 5.5rem 1.5rem 4rem;
    box-sizing: border-box;
  }

  /* ── Floating social dock — Apple Glass Minimal ── */
  .social-dock {
    position: fixed;
    top: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.45rem 1.15rem;
    border-radius: 9999px;
    background: rgba(18, 18, 22, 0.75);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      0 12px 32px -4px rgba(0, 0, 0, 0.75),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
    transition:
      border-color 0.25s var(--ease-apple),
      transform 0.25s var(--ease-apple),
      box-shadow 0.25s var(--ease-apple);
  }

  .social-dock:hover {
    border-color: rgba(255, 255, 255, 0.16);
    box-shadow:
      0 16px 40px -4px rgba(0, 0, 0, 0.85),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
  }

  .social-dock a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    color: var(--fg-muted);
    text-decoration: none;
    transition:
      color 0.2s var(--ease-apple),
      transform 0.2s var(--ease-apple);
  }

  .social-dock a:hover {
    color: #ffffff;
    transform: scale(1.15);
  }

  .social-dock a:active {
    transform: scale(0.92);
  }

  .page-content {
    width: 100%;
    max-width: 1100px;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  /* ── Section 1 : Présentation (Étalée horizontalement et compacte) ── */
  .section-presentation {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .presentation-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 1.5rem;
  }

  .profile-group {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .name-avatar {
    flex: 0 0 auto;
    width: auto;
    height: auto;
    background: transparent;
    border: none;
    box-shadow: none;
    position: relative;
    overflow: visible;
  }

  .name-avatar img {
    height: 74px;
    width: auto;
    object-fit: contain;
    display: block;
    filter: none;
    transition: transform 0.25s var(--ease-apple);
  }

  .name-avatar img:hover {
    transform: scale(1.05) translateY(-2px);
  }

  .name-titles {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .kicker {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent-blue);
    margin: 0;
  }

  .name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 3.8vw, 2.6rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin: 0;
  }

  .role {
    font-size: 0.95rem;
    font-weight: 500;
    color: #a1a1aa;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .role__sep {
    color: var(--accent-blue);
    font-weight: 700;
    opacity: 0.8;
  }

  .bio {
    width: 100%;
    max-width: 68ch;
    font-size: 0.94rem;
    line-height: 1.65;
    color: #a1a1aa;
    margin: 0;
  }

  .learning-badges {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .codewars-badge,
  .duolingo-badge {
    display: flex;
    align-items: center;
    text-decoration: none;
    opacity: 0.9;
    transition: opacity 0.2s var(--ease-apple);
  }
  .codewars-badge:hover,
  .duolingo-badge:hover {
    opacity: 1;
  }

  .stat-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 20px;
    padding: 0 0.65rem 0 0.5rem;
    background: #303133;
    white-space: nowrap;
    clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%);
    font-size: 0.68rem;
  }
  .stat-pill img {
    display: block;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    flex: 0 0 auto;
  }
  .stat-rank {
    font-weight: 700;
    color: #ffffff;
  }
  .stat-sep {
    color: #6a6a6c;
  }
  .stat-score {
    color: #b9b9ba;
    font-variant-numeric: tabular-nums;
  }

  /* ── Section Projets Header ───────────────────────────────────────── */
  .projects-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 0.85rem;
    padding: 0.15rem 0.25rem;
  }

  .section-title-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .section-kicker {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #a1a1aa;
    text-transform: uppercase;
  }

  .section-count-badge {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    padding: 2px 8px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #e4e4e7;
  }

  .active-filter-indicator {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: rgba(18, 18, 22, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 9999px;
    padding: 0.25rem 0.75rem 0.25rem 0.85rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.6);
  }

  .active-filter-indicator[hidden] {
    display: none !important;
  }

  .active-filter-text {
    font-size: 0.75rem;
    color: #a1a1aa;
    font-weight: 500;
  }

  .active-filter-badge-box {
    display: inline-flex;
    align-items: center;
  }

  .active-filter-img {
    height: 18px;
    width: auto;
    border-radius: 3px;
    display: block;
  }

  .filter-clear-btn {
    background: transparent;
    border: none;
    color: #e4e4e7;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0 0 0 0.35rem;
    cursor: pointer;
    transition: color 0.15s;
  }

  .filter-clear-btn:hover {
    color: #ff6b6b;
  }

  /* ── Section 2 : Projets ─────────────────────────────────────────── */
  .section-projects {
    width: 100%;
  }

  @media (max-width: 820px) {
    .site {
      padding: 5rem 1rem 2.5rem;
    }
    .page-content {
      gap: 1.5rem;
    }
    .presentation-header-row {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 0.85rem;
    }
    .profile-group {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 0.65rem;
    }
    .name-titles {
      align-items: center;
    }
    .role {
      justify-content: center;
    }
    .bio {
      text-align: center;
    }
    .learning-badges {
      justify-content: center;
    }
  }

  .stage {
    position: relative;
    display: flex;
    align-items: stretch;
    width: 100%;
    max-width: 1100px;
    aspect-ratio: 2.2 / 1;
    margin: 0 auto;
    flex-shrink: 0;
    border-radius: 16px;
    background: #12100e;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 20px 50px -12px rgba(0, 0, 0, 0.85);
    overflow: hidden;
  }

  /* ── Roulette — vertical picker ── */
  .roulette {
    position: relative;
    flex: 0 0 clamp(130px, 15vw, 180px);
    border-right: 1px solid rgba(255, 255, 255, 0.06);
  }

  /* The scroll container is a plain block, separate from the marker below —
     mixing position:sticky with scroll-snap on the same element is what
     was hanging Chromium's layout, so the two are kept apart. */
  .roulette-scroll {
    height: 100%;
    overflow-y: auto;
    scroll-snap-type: y mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .roulette-scroll::-webkit-scrollbar {
    display: none;
  }

  .roulette-marker {
    position: absolute;
    top: 50%;
    left: -0.5rem;
    right: -0.5rem;
    height: 2.3rem;
    transform: translateY(-50%);
    border-radius: 8px;
    border-left: 2px solid var(--marker-accent, var(--accent-gold));
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--marker-accent, var(--accent-gold)) 12%, transparent),
      transparent 70%
    );
    box-shadow: 0 0 14px -4px color-mix(in srgb, var(--marker-accent, var(--accent-gold)) 65%, transparent);
    transition: border-color 0.25s var(--ease-apple), box-shadow 0.25s var(--ease-apple);
    z-index: 0;
    pointer-events: none;
  }

  .roulette-track {
    display: flex;
    flex-direction: column;
    /* Vertical padding-percentage is resolved against the container's
       WIDTH per spec, not its height — useless here, so the real centering
       padding is computed in JS from the measured pixel height instead. */
  }

  .roulette-item {
    scroll-snap-align: center;
    flex: 0 0 2.3rem;
    display: flex;
    align-items: center;
    padding: 0 0.5rem 0 1.1rem;
    background: none;
    border: none;
    cursor: pointer;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    text-align: left;
    color: var(--fg-muted);
    opacity: 0.5;
    transform: scale(0.94);
    transform-origin: left center;
    transition: color 0.25s var(--ease-apple), opacity 0.25s var(--ease-apple), transform 0.25s var(--ease-apple);
  }

  .roulette-item[aria-selected='true'] {
    color: var(--fg);
    font-weight: 700;
    opacity: 1;
    transform: scale(1);
  }

  @media (max-width: 700px) {
    .stage {
      flex-direction: column;
      aspect-ratio: auto;
      height: auto;
      max-width: none;
      /* Desktop-only fix (roulette-marker doesn't exist here) — stacked
         content should stay centered, not nudged right. */
      padding-left: 0;
    }

    /* The desktop picker (fixed marker, list scrolls past it) reads as a
       gimmick on a touch screen — swiping a list past a stationary frame
       isn't a pattern people expect to tap. A tab row read too unfamiliar
       in turn — a compact vertical stack, same idea as desktop's list
       (bold + full opacity = selected, inherited from the base rule below)
       just without the scroll-driven marker, reads the most natural. */
    .roulette {
      order: 2;
      flex: 0 0 auto;
    }
    .roulette-scroll {
      height: auto;
      overflow: visible;
      scroll-snap-type: none;
    }
    .roulette-marker {
      display: none;
    }
    .roulette-track {
      flex-direction: column;
      align-items: center;
      gap: 0.35rem;
      padding: 0;
    }
    .roulette-item {
      flex: 0 0 auto;
      height: auto;
      padding: 0.3rem 0.85rem;
      text-align: center;
      border-radius: 8px;
      border-left: 2px solid transparent;
      scroll-snap-align: none;
    }
    /* Exactly the desktop marker pill's own rule set (border-left, gradient
       fill, glow) — not a uniform 4-side border, which reads as a different,
       flatter shape. Thick edge on the left only, soft fade on the rest. */
    .roulette-item[aria-selected='true'] {
      border-left-color: var(--marker-accent, var(--accent-gold));
      background: linear-gradient(
        to right,
        color-mix(in srgb, var(--marker-accent, var(--accent-gold)) 12%, transparent),
        transparent 70%
      );
      box-shadow: 0 0 14px -4px color-mix(in srgb, var(--marker-accent, var(--accent-gold)) 65%, transparent);
    }

    .detail-stage {
      position: relative;
      flex: 1;
      order: 1;
      min-height: 360px;
    }

    /* ProjectCard's mobile layout now stacks image above text in normal
       flow instead of absolutely overlapping them, so .detail-slot needs
       to grow with that content rather than being clipped to a fixed box. */
    .detail-slot {
      position: static;
    }
  }

  .detail-stage {
    position: relative;
    flex: 1;
    min-width: 0;
  }

  .detail-slot {
    display: none;
    position: absolute;
    inset: 0;
  }

  .detail-slot.is-active {
    display: block;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // ── Project selector (niveau 2) — click a name, its panel shows. The
    // list also scrolls the clicked item to center for visual polish, but
    // that scroll is cosmetic only — selection itself is direct, not
    // inferred from scroll position (a short list that already fits on
    // screen never scrolls, which used to mean the panel never updated). ──
    const cells = Array.from(document.querySelectorAll('.roulette-item')) as HTMLButtonElement[];
    const slots = Array.from(document.querySelectorAll('.detail-slot')) as HTMLElement[];
    const rouletteTrack = document.querySelector('.roulette-scroll') as HTMLElement | null;
    const rouletteTrackInner = document.querySelector('.roulette-track') as HTMLElement | null;
    const roulette = document.querySelector('.roulette') as HTMLElement | null;

    if (slots.length > 0) {
      // Vertical padding-percentage resolves against the container's WIDTH
      // per the CSS spec, not its height, so it can't center a short list
      // in a tall box — computed in real pixels here instead, on desktop
      // only (mobile's horizontal layout already centers fine via CSS %).
      if (rouletteTrack && rouletteTrackInner && cells[0] && !window.matchMedia('(max-width: 700px)').matches) {
        const pad = Math.max(0, rouletteTrack.clientHeight / 2 - cells[0].clientHeight / 2);
        rouletteTrackInner.style.paddingTop = `${pad}px`;
        rouletteTrackInner.style.paddingBottom = `${pad}px`;
      }

      const select = (index: number) => {
        cells.forEach((cell) => {
          const isSelected = Number(cell.dataset.index) === index;
          cell.setAttribute('aria-selected', String(isSelected));
          if (isSelected && roulette && cell.dataset.accent) {
            roulette.style.setProperty('--marker-accent', cell.dataset.accent);
          }
        });
        slots.forEach((slot) => {
          const isActive = Number(slot.dataset.index) === index;
          slot.classList.toggle('is-active', isActive);
          const video = slot.querySelector('video');
          if (video) {
            if (isActive) {
              video.play().catch(() => {});
            } else {
              video.pause();
            }
          }
        });
      };

      cells.forEach((cell) => {
        cell.addEventListener('click', () => {
          select(Number(cell.dataset.index));
          // Scroll only the roulette itself (not scrollIntoView, which can
          // bubble to ancestor scroll containers like the level track).
          if (!rouletteTrack) return;
          rouletteTrack.scrollTo({
            top: cell.offsetTop - rouletteTrack.clientHeight / 2 + cell.clientHeight / 2,
            behavior: 'smooth',
          });
        });
      });

      // Scrolling/dragging the list also changes the selection — whichever
      // item is closest to the marker once scrolling settles wins. Simple
      // "closest wins" on scroll-end, not a live threshold watch, so it
      // can't silently stop firing the way the old IntersectionObserver did.
      if (rouletteTrack) {
        let scrollSettleTimer: ReturnType<typeof setTimeout>;
        rouletteTrack.addEventListener('scroll', () => {
          clearTimeout(scrollSettleTimer);
          scrollSettleTimer = setTimeout(() => {
            const isMobile = window.matchMedia('(max-width: 700px)').matches;
            const visibleCells = cells.filter((c) => c.style.display !== 'none');
            if (visibleCells.length === 0) return;
            const trackCenter = isMobile
              ? rouletteTrack.scrollLeft + rouletteTrack.clientWidth / 2
              : rouletteTrack.scrollTop + rouletteTrack.clientHeight / 2;
            let closest = visibleCells[0];
            let closestDist = Infinity;
            visibleCells.forEach((cell) => {
              const cellCenter = isMobile
                ? cell.offsetLeft + cell.clientWidth / 2
                : cell.offsetTop + cell.clientHeight / 2;
              const dist = Math.abs(cellCenter - trackCenter);
              if (dist < closestDist) {
                closestDist = dist;
                closest = cell;
              }
            });
            select(Number(closest.dataset.index));
          }, 120);
        });
      }

      select(0);
      // Center the first item within the roulette itself only — scrollIntoView()
      // can bubble to ancestor scroll containers (the level track) and fight
      // its own scroll-snap on load, so scrollTop is set directly instead.
      if (rouletteTrack && cells[0]) {
        requestAnimationFrame(() => {
          const target = cells[0];
          rouletteTrack.scrollTop =
            target.offsetTop - rouletteTrack.clientHeight / 2 + target.clientHeight / 2;
        });
      }

      const scrollToCell = (cell: HTMLElement) => {
        if (!rouletteTrack) return;
        const isMobile = window.matchMedia('(max-width: 700px)').matches;
        if (isMobile) {
          rouletteTrack.scrollTo({
            left: cell.offsetLeft - rouletteTrack.clientWidth / 2 + cell.clientWidth / 2,
            behavior: 'smooth',
          });
        } else {
          rouletteTrack.scrollTo({
            top: cell.offsetTop - rouletteTrack.clientHeight / 2 + cell.clientHeight / 2,
            behavior: 'smooth',
          });
        }
      };

      // ── Technology Stack Filter (Direct Badges Interaction) ──
      const projectsCountEl = document.getElementById('projects-count');
      const activeFilterIndicator = document.getElementById('active-filter-indicator') as HTMLElement | null;
      const activeFilterBadgeImg = document.getElementById('active-filter-badge-img') as HTMLImageElement | null;
      const activeFilterResetBtn = document.getElementById('active-filter-reset') as HTMLButtonElement | null;

      const tagBadgeMap: Record<string, string> = {
        Python: 'https://img.shields.io/badge/python-%233670A0.svg?style=for-the-badge&logo=python&logoColor=ffdd54',
        Databricks: 'https://img.shields.io/badge/Databricks-%23FF3621.svg?style=for-the-badge&logo=databricks&logoColor=white',
        Azure: 'https://img.shields.io/badge/azure-%230078D4.svg?style=for-the-badge&logo=microsoftazure&logoColor=white',
        'Azure Functions': 'https://img.shields.io/badge/Azure%20Functions-%230062AD.svg?style=for-the-badge&logo=azurefunctions&logoColor=white',
        'Delta Lake': 'https://img.shields.io/badge/Delta%20Lake-00ADD8.svg?style=for-the-badge',
        Terraform: 'https://img.shields.io/badge/terraform-%235835CC.svg?style=for-the-badge&logo=terraform&logoColor=white',
        Snowflake: 'https://img.shields.io/badge/snowflake-%2329B5E8.svg?style=for-the-badge&logo=snowflake&logoColor=white',
        dbt: 'https://img.shields.io/badge/dbt-%23FF694B.svg?style=for-the-badge&logo=dbt&logoColor=white',
        Streamlit: 'https://img.shields.io/badge/Streamlit-%23FE4B4B.svg?style=for-the-badge&logo=streamlit&logoColor=white',
        Docker: 'https://img.shields.io/badge/docker-%230db7ed.svg?style=for-the-badge&logo=docker&logoColor=white',
        FastAPI: 'https://img.shields.io/badge/fastapi-%23009688.svg?style=for-the-badge&logo=fastapi&logoColor=white',
        React: 'https://img.shields.io/badge/react-%2320232a.svg?style=for-the-badge&logo=react&logoColor=%2361DAFB',
        Supabase: 'https://img.shields.io/badge/Supabase-%233ECF8E.svg?style=for-the-badge&logo=supabase&logoColor=white',
      };
      const getBadge = (tag: string) =>
        tagBadgeMap[tag] ?? `https://img.shields.io/badge/${encodeURIComponent(tag)}-8f8c86.svg?style=for-the-badge`;

      let currentFilteredTag = '';

      const filterByTag = (tag: string) => {
        currentFilteredTag = tag;

        if (!tag) {
          cells.forEach((cell) => {
            cell.style.display = '';
          });
          if (activeFilterIndicator) activeFilterIndicator.hidden = true;
          if (projectsCountEl) {
            projectsCountEl.textContent = `${cells.length} PROJETS`;
          }
          return;
        }

        if (activeFilterIndicator && activeFilterBadgeImg) {
          activeFilterBadgeImg.src = getBadge(tag);
          activeFilterBadgeImg.alt = tag;
          activeFilterIndicator.hidden = false;
        }

        let firstMatchIndex: number | null = null;
        let currentMatches = false;
        let matchCount = 0;
        const currentActiveSlot = slots.find((s) => s.classList.contains('is-active'));
        const currentIdx = currentActiveSlot ? Number(currentActiveSlot.dataset.index) : 0;

        cells.forEach((cell) => {
          let projectTags: string[] = [];
          try {
            projectTags = JSON.parse(cell.dataset.tags ?? '[]');
          } catch {
            projectTags = [];
          }
          const matches = projectTags.includes(tag);
          cell.style.display = matches ? '' : 'none';

          if (matches) {
            matchCount++;
            const idx = Number(cell.dataset.index);
            if (firstMatchIndex === null) firstMatchIndex = idx;
            if (idx === currentIdx) currentMatches = true;
          }
        });

        if (projectsCountEl) {
          projectsCountEl.textContent = `${matchCount} PROJET${matchCount > 1 ? 'S' : ''}`;
        }

        const targetIdx = currentMatches ? currentIdx : firstMatchIndex;
        if (targetIdx !== null) {
          select(targetIdx);
          const targetCell = cells.find((c) => Number(c.dataset.index) === targetIdx);
          if (targetCell) scrollToCell(targetCell);
        }
      };

      if (activeFilterResetBtn) {
        activeFilterResetBtn.addEventListener('click', () => {
          filterByTag('');
        });
      }

      // Clicking a project tag badge inside any project card triggers tag filter
      document.addEventListener(
        'click',
        (e) => {
          const tagEl = (e.target as HTMLElement).closest('.project-tag') as HTMLElement | null;
          if (!tagEl) return;
          e.preventDefault();
          e.stopPropagation();
          const tag = tagEl.dataset.tag;
          if (!tag) return;
          if (currentFilteredTag === tag) {
            filterByTag('');
          } else {
            filterByTag(tag);
          }
        },
        true
      );

      // Keyboard support for project tag badges
      document.addEventListener(
        'keydown',
        (e) => {
          if (e.key !== 'Enter' && e.key !== ' ') return;
          const tagEl = (e.target as HTMLElement).closest('.project-tag') as HTMLElement | null;
          if (!tagEl) return;
          e.preventDefault();
          e.stopPropagation();
          const tag = tagEl.dataset.tag;
          if (!tag) return;
          if (currentFilteredTag === tag) {
            filterByTag('');
          } else {
            filterByTag(tag);
          }
        },
        true
      );
    }

    fetch('/api/duolingo')
      .then((res) => (res.ok ? res.json() : Promise.reject()))
      .then((data: { users?: { streak?: number; totalXp?: number }[] }) => {
        const user = data.users?.[0];
        const streakEl = document.querySelector('[data-duolingo-streak]');
        const xpEl = document.querySelector('[data-duolingo-xp]');
        if (streakEl && typeof user?.streak === 'number') {
          streakEl.textContent = String(user.streak);
        }
        if (xpEl && typeof user?.totalXp === 'number') {
          xpEl.textContent = user.totalXp.toLocaleString('en-US');
        }
      })
      .catch(() => {
        // relais nginx pas encore en place / indisponible : on garde les valeurs statiques
      });
  });
</script>
